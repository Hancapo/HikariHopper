<Project>
  <!--
    The game libraries, for the app and its tests alike: FiveFury (GTA V) and RedFury (RDR2, with its world), consumed as managed .NET
    libraries, and the CommonFury both build on. They share FiveFury's checkout of CommonFury (CommonFuryRoot, see
    Directory.Build.props): each is built with CommonFuryRoot set alike and CommonFury is referenced directly, so it is
    one project built once. The libraries' own references to it aren't brought in as well (they'd add RedFury's
    submodule copy, and FiveFury's again without the setting).
    They're always built in their Release configuration, a Debug build of the app and its tests included: unoptimised,
    reading a game's files is about ten times slower, and the tests that read a real game took most of the suite's time.
  -->
  <PropertyGroup>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <!-- A solution build drops the Configuration of projects outside the solution, here and in the libraries' own
         references, so they'd build in Debug; this keeps it, and the libraries get it as a global property. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
    <GameLibraryProperties>CommonFuryRoot=$(CommonFuryRoot);Configuration=Release;ShouldUnsetParentConfigurationAndPlatform=false</GameLibraryProperties>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(FiveFuryRoot)FiveFury/FiveFury.csproj" AdditionalProperties="$(GameLibraryProperties)" />
    <ProjectReference Include="$(RedFuryRoot)RedFury/RedFury.csproj" AdditionalProperties="$(GameLibraryProperties)" />
    <!-- RDR2's world: its index of maps and placements, and their levels of detail (no rendering of its own). -->
    <ProjectReference Include="$(RedFuryRoot)RedFury.World/RedFury.World.csproj" AdditionalProperties="$(GameLibraryProperties)" />
    <ProjectReference Include="$(CommonFuryRoot)CommonFury/CommonFury.csproj" AdditionalProperties="$(GameLibraryProperties)" />
  </ItemGroup>
</Project>
