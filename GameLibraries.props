<Project>
  <!--
    The game libraries, for the app and its tests alike: FiveFury (GTA V) and RedFury (RDR2), consumed as managed .NET
    libraries, and the CommonFury both build on. They share FiveFury's checkout of CommonFury (CommonFuryRoot, see
    Directory.Build.props): each is built with CommonFuryRoot set alike and CommonFury is referenced directly, so it is
    one project built once. The libraries' own references to it aren't brought in as well (they'd add RedFury's
    submodule copy, and FiveFury's again without the setting).
  -->
  <PropertyGroup>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(FiveFuryRoot)FiveFury/FiveFury.csproj" AdditionalProperties="CommonFuryRoot=$(CommonFuryRoot)" />
    <ProjectReference Include="$(RedFuryRoot)RedFury/RedFury.csproj" AdditionalProperties="CommonFuryRoot=$(CommonFuryRoot)" />
    <ProjectReference Include="$(CommonFuryRoot)CommonFury/CommonFury.csproj" AdditionalProperties="CommonFuryRoot=$(CommonFuryRoot)" />
  </ItemGroup>
</Project>
