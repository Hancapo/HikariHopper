<Project>
  <!--
    The game libraries, for the app and its tests alike: FiveFury (GTA V) and RedFury (RDR2, with its world), consumed as managed .NET
    libraries, and the CommonFury both build on. They share the app's checkout of CommonFury (CommonFuryRoot, see
    Directory.Build.props): each is built with CommonFuryRoot set alike and CommonFury is referenced directly, so it is
    one project built once, and the libraries' own CommonFury submodules aren't built at all.
    They're always built in their Release configuration, a Debug build of the app and its tests included: unoptimised,
    reading a game's files is about ten times slower, and the tests that read a real game took most of the suite's time.
  -->
  <PropertyGroup>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(FiveFuryRoot)FiveFury/FiveFury.csproj" AdditionalProperties="CommonFuryRoot=$(CommonFuryRoot);Configuration=Release" />
    <ProjectReference Include="$(RedFuryRoot)RedFury/RedFury.csproj" AdditionalProperties="CommonFuryRoot=$(CommonFuryRoot);Configuration=Release" />
    <!-- RDR2's world: its index of maps and placements, and their levels of detail (no rendering of its own). -->
    <ProjectReference Include="$(RedFuryRoot)RedFury.World/RedFury.World.csproj" AdditionalProperties="CommonFuryRoot=$(CommonFuryRoot);Configuration=Release" />
    <ProjectReference Include="$(CommonFuryRoot)CommonFury/CommonFury.csproj" AdditionalProperties="CommonFuryRoot=$(CommonFuryRoot);Configuration=Release" />
    <!-- wgpu, which the 3D views draw with, and its native library as built in the WGpuFury checkout. -->
    <ProjectReference Include="$(WGpuFuryRoot)src/WGpuFury/WGpuFury.csproj" AdditionalProperties="Configuration=Release" />
    <None Include="$(WGpuFuryRoot)native/win-x64/lib/wgpu_native.dll" Link="wgpu_native.dll" Visible="false" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckWGpuFury" BeforeTargets="_GetProjectReferenceTargetFrameworkProperties;ResolveProjectReferences"
          Condition="!Exists('$(WGpuFuryRoot)native/win-x64/lib/wgpu_native.dll')">
    <Error Text="WGpuFury's wgpu-native was not found at $(WGpuFuryRoot)native/win-x64/lib. Set WGPUFURY_ROOT to a WGpuFury checkout and build it there (dotnet run eng/build-native.cs)." />
  </Target>
  <Target Name="CheckCommonFury" BeforeTargets="_GetProjectReferenceTargetFrameworkProperties;ResolveProjectReferences"
          Condition="!Exists('$(CommonFuryRoot)CommonFury/CommonFury.csproj')">
    <Error Text="CommonFury was not found at $(CommonFuryRoot). Run 'git submodule update --init', or set COMMONFURY_ROOT to a CommonFury.NET checkout." />
  </Target>
</Project>
