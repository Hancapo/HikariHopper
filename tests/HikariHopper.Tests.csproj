<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia.Headless.XUnit 12.1.5 is built against xunit.v3 3.2.x. -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Avalonia.Headless.XUnit" />
  </ItemGroup>
  <ItemGroup>
    <!-- The rendering tests' own shaders, read with their file name. -->
    <EmbeddedResource Include="Shaders/*.wgsl" LogicalName="HikariHopper.Tests.Shaders.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../src/HikariHopper.csproj" />
  </ItemGroup>
  <!-- The tests use the game libraries directly too, from the same place as the app. -->
  <Import Project="../GameLibraries.props" />
</Project>
