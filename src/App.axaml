<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HikariHopper.App"
             RequestedThemeVariant="Dark">
  <!-- Fluent is only the base for controls nobody has ported yet; every HikariHopper control
       below replaces its template entirely with the QML one. -->
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://HikariHopper/Views/Textures/TextureDialogStyles.axaml" />
    <!-- Every window, whatever its class, shows the app icon in the taskbar and Alt+Tab. -->
    <Style Selector=":is(Window)">
      <Setter Property="Icon" Value="/Assets/Branding/HikariHopper.ico" />
    </Style>
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <!-- Windows that draw their own title bar over the native frame (ExtendClientAreaToDecorationsHint) use this
           as their WindowDecorationsTheme: Avalonia draws none of its own decorations over theirs. -->
      <ControlTheme x:Key="NoDrawnDecorations" TargetType="WindowDrawnDecorations">
        <Setter Property="Template">
          <WindowDrawnDecorationsTemplate>
            <WindowDrawnDecorationsContent />
          </WindowDrawnDecorationsTemplate>
        </Setter>
      </ControlTheme>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://HikariHopper/Views/Controls/FlatTextField.axaml" />
        <ResourceInclude Source="avares://HikariHopper/Views/Controls/ChromeToolButton.axaml" />
        <ResourceInclude Source="avares://HikariHopper/Views/Controls/WindowControlButton.axaml" />
        <ResourceInclude Source="avares://HikariHopper/Views/Controls/MenuBarButton.axaml" />
        <ResourceInclude Source="avares://HikariHopper/Views/Controls/SquareCheckBox.axaml" />
        <ResourceInclude Source="avares://HikariHopper/Views/Controls/FlatComboBox.axaml" />
        <ResourceInclude Source="avares://HikariHopper/Views/Controls/QuietScrollBar.axaml" />
        <ResourceInclude Source="avares://HikariHopper/Views/Controls/RetroMenu.axaml" />
        <ResourceInclude Source="avares://HikariHopper/Views/Controls/RetroMenuSection.axaml" />
        <ResourceInclude Source="avares://HikariHopper/Views/Controls/RetroMenuSeparator.axaml" />
        <ResourceInclude Source="avares://HikariHopper/Views/Controls/SplitViewHandle.axaml" />
        <ResourceInclude Source="avares://HikariHopper/Views/ModalSheet.axaml" />
        <ResourceInclude Source="avares://HikariHopper/Views/Textures/TextureToolDialog.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
