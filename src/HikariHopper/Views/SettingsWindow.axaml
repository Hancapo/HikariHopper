<v:ToolWindow xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:v="using:HikariHopper.Views"
              xmlns:ui="using:HikariHopper.Ui"
              x:Class="HikariHopper.Views.SettingsWindow"
              x:DataType="v:SettingsWindow"
              Width="1080" Height="688" MinWidth="820" MinHeight="620"
              Title="Settings"
              Heading="SETTINGS"
              BodyMargin="0"
              FooterText="Changes are saved immediately">
  <!-- Port of SettingsWindow.qml: a 196px group rail and the options panel for game paths. -->
  <Grid ColumnDefinitions="196,1,*">
    <Panel Grid.Column="0" Background="{x:Static ui:Theme.SidebarBg}">
      <StackPanel VerticalAlignment="Top">
        <v:SettingsPanelHeader Label="GROUPS" />
        <v:SettingsGroupRow Label="Game paths" Note="9 titles" Available="True" Selected="True" />
        <v:SettingsGroupRow Label="Explorer" Note="Later" Available="False" />
        <v:SettingsGroupRow Label="Appearance" Note="Later" Available="False" />
      </StackPanel>
      <TextBlock Margin="12,0,12,14" VerticalAlignment="Bottom" Text="Additional groups will appear later."
                 Foreground="{x:Static ui:Theme.TextFaint}"
                 FontFamily="{x:Static ui:Theme.UiFont}" FontSize="{x:Static ui:Theme.SmallFontSize}"
                 TextWrapping="Wrap" />
    </Panel>

    <Border Grid.Column="1" Background="{x:Static ui:Theme.BorderHard}" />

    <Panel Grid.Column="2">
      <v:SettingsPanelHeader Label="OPTIONS  /  GAME PATHS" VerticalAlignment="Top" />
      <TextBlock Margin="16,38,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Text="SUPPORTED"
                 Foreground="{x:Static ui:Theme.TextDim}"
                 FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="{x:Static ui:Theme.SmallFontSize}"
                 FontWeight="Bold" LetterSpacing="1" />
      <StackPanel Margin="12,58,12,0" VerticalAlignment="Top">
        <v:GamePathRow Name="LegacyRow" GameName="Grand Theft Auto V Legacy"
                       ExpectedExecutable="GTA5.exe" Supported="True"
                       GamePath="{Binding GamePaths.LegacyPath}" PathValid="{Binding GamePaths.LegacyPathValid}" />
        <v:GamePathRow Name="EnhancedRow" GameName="Grand Theft Auto V Enhanced"
                       ExpectedExecutable="GTA5_Enhanced.exe" Supported="True"
                       GamePath="{Binding GamePaths.EnhancedPath}" PathValid="{Binding GamePaths.EnhancedPathValid}" />
      </StackPanel>
      <TextBlock Margin="16,194,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Text="FUTURE SUPPORT"
                 Foreground="{x:Static ui:Theme.TextDim}"
                 FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="{x:Static ui:Theme.SmallFontSize}"
                 FontWeight="Bold" LetterSpacing="1" />
      <ItemsControl Margin="12,214,12,0" VerticalAlignment="Top" ItemsSource="{Binding FutureGames}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <v:GamePathRow GameName="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Panel>
  </Grid>
</v:ToolWindow>
