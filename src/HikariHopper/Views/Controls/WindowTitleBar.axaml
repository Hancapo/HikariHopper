<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:HikariHopper.Views.Controls"
             xmlns:ui="using:HikariHopper.Ui"
             x:Class="HikariHopper.Views.Controls.WindowTitleBar"
             x:DataType="c:WindowTitleBar"
             Background="{x:Static ui:Theme.ChromeRaised}">
  <!-- Port of WindowTitleBar.qml: application-owned decoration backed by native window
       operations. Dragging the title area performs a system move (so snapping stays native),
       double-clicking it maximizes or restores when the window offers maximize. -->
  <Panel>
    <Border Height="1" VerticalAlignment="Top" Background="{x:Static ui:Theme.Bevel}" />
    <Border Height="1" VerticalAlignment="Bottom" Background="{x:Static ui:Theme.BorderHard}" />
    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
      <Panel Name="DragArea" Grid.Column="0" Background="Transparent">
        <DockPanel Margin="9,0,8,0">
          <Border DockPanel.Dock="Left" Width="12" Height="12" VerticalAlignment="Center"
                  BorderBrush="{x:Static ui:Theme.Brass}" BorderThickness="1">
            <Border Width="3" Height="3" Margin="1,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="{x:Static ui:Theme.Brass}" />
          </Border>
          <TextBlock Name="TitleLabel" Margin="8,0,0,0" Text="{Binding TitleText, RelativeSource={RelativeSource AncestorType=c:WindowTitleBar}}"
                     Foreground="{x:Static ui:Theme.TextRow}"
                     FontFamily="{x:Static ui:Theme.UiFont}" FontSize="{x:Static ui:Theme.SmallFontSize}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Panel>
      <c:WindowControlButton Name="MinimizeButton" Grid.Column="1" Kind="minimize" Height="NaN"
                             VerticalAlignment="Stretch"
                             AutomationProperties.Name="Minimize window" />
      <c:WindowControlButton Name="MaximizeButton" Grid.Column="2" Kind="maximize" Height="NaN"
                             VerticalAlignment="Stretch" />
      <c:WindowControlButton Name="CloseButton" Grid.Column="3" Kind="close" Height="NaN"
                             VerticalAlignment="Stretch"
                             AutomationProperties.Name="Close window" />
    </Grid>
  </Panel>
</UserControl>
