<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:HikariHopper.Views.Controls"
                    xmlns:ui="using:HikariHopper.Ui">
  <!-- Port of RetroMenuSection.qml: a 22px mono, bold, letterspaced caps heading. -->
  <ControlTheme x:Key="{x:Type c:RetroMenuSection}" TargetType="c:RetroMenuSection">
    <Setter Property="Height" Value="22" />
    <Setter Property="MinWidth" Value="{x:Static ui:Theme.MenuMinimumWidth}" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <TextBlock Text="{TemplateBinding Text}" Margin="11,0"
                   Foreground="{x:Static ui:Theme.TextDim}"
                   FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="{x:Static ui:Theme.SmallFontSize}"
                   FontWeight="Bold" LetterSpacing="1" VerticalAlignment="Center" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
