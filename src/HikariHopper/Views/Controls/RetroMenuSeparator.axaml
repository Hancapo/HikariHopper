<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:HikariHopper.Views.Controls"
                    xmlns:ui="using:HikariHopper.Ui">
  <!-- Port of RetroMenuSeparator.qml: menuSeparatorHeight tall, inset 11px each side, a hard
       seam at y 3 over a bevel at y 4. -->
  <ControlTheme x:Key="{x:Type c:RetroMenuSeparator}" TargetType="c:RetroMenuSeparator">
    <Setter Property="Height" Value="{x:Static ui:Theme.MenuSeparatorHeight}" />
    <Setter Property="MinWidth" Value="{x:Static ui:Theme.MenuMinimumWidth}" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Margin="11,0">
          <Border Height="1" Margin="0,3,0,0" VerticalAlignment="Top" Background="{x:Static ui:Theme.BorderHard}" />
          <Border Height="1" Margin="0,4,0,0" VerticalAlignment="Top" Background="{x:Static ui:Theme.Bevel}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
