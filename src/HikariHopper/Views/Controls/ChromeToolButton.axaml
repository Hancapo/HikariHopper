<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:HikariHopper.Views.Controls"
                    xmlns:ui="using:HikariHopper.Ui">
  <!-- Port of ChromeToolButton.qml. States are computed in ChromeToolButton.cs, which mirrors
       the QML binding expressions part by part. -->
  <ControlTheme x:Key="{x:Type c:ChromeToolButton}" TargetType="c:ChromeToolButton">
    <Setter Property="Padding" Value="0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Background" BorderBrush="{x:Static ui:Theme.BorderHard}" />
          <Border Name="PART_Bevel" Height="1" Margin="1,1,1,0" VerticalAlignment="Top" />
          <c:ChromeIcon Name="PART_Icon" Kind="{TemplateBinding IconKind}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Name="PART_Text" Text="{TemplateBinding Text}"
                     FontFamily="{x:Static ui:Theme.UiFont}" FontSize="{x:Static ui:Theme.FontSize}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
