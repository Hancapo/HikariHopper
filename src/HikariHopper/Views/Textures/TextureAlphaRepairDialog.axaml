<v:TextureToolDialog xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:v="using:HikariHopper.Views"
                     xmlns:c="using:HikariHopper.Views.Controls"
                     x:Class="HikariHopper.Views.TextureAlphaRepairDialog"
                     Heading="REPAIR ALPHA EDGES" BodyHeight="240">
  <!-- Port of TextureAlphaRepairDialog.qml. -->
  <c:QtColumnLayout Margin="12" Spacing="10">
    <v:TextureDialogSummary />
    <Border Classes="rule" />
    <TextBlock Classes="body"
               Text="Repairs dark RGB bleeding around transparent pixels while preserving the stored alpha chain." />
    <v:QtGrid ColumnDefinitions="112,12,*">
      <TextBlock Classes="label" Text="Repair radius" />
      <c:FlatComboBox Name="RadiusCombo" Grid.Column="2" />
    </v:QtGrid>
    <Panel c:QtColumnLayout.FillHeight="True" />
  </c:QtColumnLayout>
</v:TextureToolDialog>
