<v:TextureToolDialog xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:v="using:HikariHopper.Views"
                     xmlns:c="using:HikariHopper.Views.Controls"
                     x:Class="HikariHopper.Views.TextureRenameDialog"
                     Heading="RENAME TEXTURE" BodyHeight="158" ApplyLabel="Rename">
  <!-- Port of TextureRenameDialog.qml. -->
  <c:QtColumnLayout Margin="12" Spacing="10">
    <v:TextureDialogSummary />
    <Border Classes="rule" />
    <v:QtGrid ColumnDefinitions="112,12,*">
      <TextBlock Classes="label" Text="Texture name" />
      <c:FlatTextField Name="NameField" Grid.Column="2" MaxLength="255" />
    </v:QtGrid>
    <Panel c:QtColumnLayout.FillHeight="True" />
  </c:QtColumnLayout>
</v:TextureToolDialog>
