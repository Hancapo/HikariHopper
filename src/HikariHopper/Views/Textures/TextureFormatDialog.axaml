<v:TextureToolDialog xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:v="using:HikariHopper.Views"
                     xmlns:c="using:HikariHopper.Views.Controls"
                     x:Class="HikariHopper.Views.TextureFormatDialog"
                     Heading="CHANGE TEXTURE FORMAT" BodyHeight="292">
  <!-- Port of TextureFormatDialog.qml. -->
  <c:QtColumnLayout Margin="12" Spacing="10">
    <v:TextureDialogSummary />
    <Border Classes="rule" />
    <v:QtGrid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto">
      <TextBlock Classes="label" Text="Target format" />
      <c:FlatComboBox Name="FormatCombo" Grid.Column="2" />
      <TextBlock Classes="label" Grid.Row="2" Text="Compression" />
      <v:TextureQualityCombo Name="QualityCombo" Grid.Row="2" Grid.Column="2" />
      <TextBlock Classes="label" Grid.Row="4" Text="Downsampling" />
      <v:TextureFilterCombo Name="FilterCombo" Grid.Row="4" Grid.Column="2" />
      <TextBlock Classes="label" Grid.Row="6" Text="Smallest mip" />
      <v:TextureMipSizeCombo Name="MipSizeCombo" Grid.Row="6" Grid.Column="2" />
    </v:QtGrid>
    <Panel Height="48">
      <Border Classes="result" />
      <TextBlock Classes="caption" Text="RESULT" />
      <TextBlock Name="ResultText" Classes="result" Margin="9,23,9,0" TextTrimming="CharacterEllipsis" />
    </Panel>
    <Panel c:QtColumnLayout.FillHeight="True" />
  </c:QtColumnLayout>
</v:TextureToolDialog>
