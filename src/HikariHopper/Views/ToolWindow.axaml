<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="using:HikariHopper.Views"
                    xmlns:c="using:HikariHopper.Views.Controls"
                    xmlns:ui="using:HikariHopper.Ui">
  <!-- Port of ToolWindow.qml: 1px inset column of title bar, body and footer, with the blue
       piping drawn on top. VisualLayerManager keeps popups above the piping, as Qt's overlay. -->
  <ControlTheme x:Key="{x:Type v:ToolWindow}" TargetType="v:ToolWindow">
    <Setter Property="Background" Value="{x:Static ui:Theme.AppBg}" />
    <Setter Property="FontFamily" Value="{x:Static ui:Theme.UiFont}" />
    <Setter Property="FontSize" Value="{x:Static ui:Theme.FontSize}" />
    <Setter Property="Foreground" Value="{x:Static ui:Theme.Text}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Background="{TemplateBinding Background}" />
          <VisualLayerManager>
            <Panel>
              <DockPanel Margin="1">
                <c:WindowTitleBar DockPanel.Dock="Top" Height="{x:Static ui:Theme.HeaderHeight}"
                                  TitleText="{TemplateBinding Heading}"
                                  ShowMinimize="False" ShowMaximize="False" />
                <Border DockPanel.Dock="Bottom" Height="44" Background="{x:Static ui:Theme.ChromeBg}">
                  <Panel>
                    <Border Height="1" VerticalAlignment="Top" Background="{x:Static ui:Theme.Border}" />
                    <TextBlock Margin="12,0,0,0" Text="{TemplateBinding FooterText}"
                               Foreground="{x:Static ui:Theme.TextFaint}"
                               FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="{x:Static ui:Theme.SmallFontSize}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <c:ChromeToolButton Name="PART_CloseButton" Width="92" Height="28" Margin="0,0,12,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Raised="True" Text="Close" />
                  </Panel>
                </Border>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Margin="{TemplateBinding BodyThickness}" />
              </DockPanel>
              <!-- The blue piping every window that owns its frame carries. -->
              <Border BorderBrush="{x:Static ui:Theme.BorderAccent}" BorderThickness="1" IsHitTestVisible="False" />
            </Panel>
          </VisualLayerManager>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
