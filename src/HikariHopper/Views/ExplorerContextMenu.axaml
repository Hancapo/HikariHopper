<c:RetroMenu xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HikariHopper.ViewModels"
             xmlns:v="using:HikariHopper.Views"
             xmlns:c="using:HikariHopper.Views.Controls"
             x:Class="HikariHopper.Views.ExplorerContextMenu"
             x:DataType="vm:ExplorerViewModel">
  <!-- Port of ExplorerContextMenu.qml. Its DataContext is the tab's view model. -->
  <c:RetroMenuItem Text="Open" Triggered="OnOpen">
    <c:RetroMenuItem.IsEnabled>
      <MultiBinding Converter="{x:Static BoolConverters.And}">
        <Binding Path="SelectionCount" Converter="{x:Static ObjectConverters.Equal}" ConverterParameter="{x:Static v:ExplorerContextMenu.One}" />
        <Binding Path="!EntryOperationBusy" />
      </MultiBinding>
    </c:RetroMenuItem.IsEnabled>
  </c:RetroMenuItem>

  <c:RetroMenuItem Name="NewEntryMenu" Text="New" IconName="plus" IsEnabled="{Binding !EntryOperationBusy}">
    <c:RetroMenuItem Text="Folder" IconName="folder" Triggered="OnNewFolder" />
    <c:RetroMenuItem Name="CreateYtdMenuItem" Text="Texture dictionary" IconName="image" Triggered="OnNewYtd" />
    <c:RetroMenuSeparator />
    <c:RetroMenuSection Name="RpfArchiveSection" Text="RPF ARCHIVE" />
    <c:RetroMenuItem Name="CreateEmptyRpfMenuItem" Text="Empty" IconName="package-plus" Triggered="OnNewEmptyRpf" />
    <c:RetroMenuItem Name="CreateRpfFromFolderMenuItem" Text="From folder…" IconName="folder-input" Triggered="OnNewRpfFromFolder" />
    <c:RetroMenuItem Name="CreateRpfFromZipMenuItem" Text="From ZIP…" IconName="file-archive" Triggered="OnNewRpfFromZip" />
  </c:RetroMenuItem>

  <c:RetroMenuSeparator />

  <c:RetroMenuItem Text="Paste" ShortcutText="Ctrl+V" IsEnabled="False" />
  <c:RetroMenuItem Name="DeleteMenuItem" Text="Delete" ShortcutText="Del" IconName="trash-2" Triggered="OnDelete">
    <c:RetroMenuItem.IsEnabled>
      <MultiBinding Converter="{x:Static BoolConverters.And}">
        <Binding Path="SelectionDeletable" />
        <Binding Path="!EntryOperationBusy" />
      </MultiBinding>
    </c:RetroMenuItem.IsEnabled>
  </c:RetroMenuItem>

  <c:RetroMenuSeparator />

  <c:RetroMenuItem Text="Refresh" ShortcutText="F5" IconName="rotate-cw" IsEnabled="{Binding !EntryOperationBusy}" Triggered="OnRefresh" />
</c:RetroMenu>
