<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>HikariHopper</RootNamespace>
    <AssemblyName>HikariHopper</AssemblyName>
    <Version>0.0.1</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" Exclude="Assets/Keys/**;Assets/Fonts/Source/**" />
    <!-- Source of the static Archivo instances; regenerate them with tools/make_archivo_instances.py. -->
    <None Include="Assets/Fonts/Source/**" />
    <EmbeddedResource Include="Assets/Keys/keys.bin" LogicalName="HikariHopper.keys.bin" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- FiveFury is consumed as a managed .NET library. -->
    <ProjectReference Include="$(FiveFuryRoot)FiveFury/FiveFury.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HikariHopper.Tests" />
  </ItemGroup>
</Project>
