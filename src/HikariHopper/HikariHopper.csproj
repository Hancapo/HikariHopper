<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>HikariHopper</RootNamespace>
    <AssemblyName>HikariHopper</AssemblyName>
    <Version>0.0.2</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Releases are Native AOT (tools/release.ps1). This also runs the AOT and trimming analyzers on every build,
         and code they flag fails it rather than the published app. -->
    <PublishAot>true</PublishAot>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2057;IL2060;IL2062;IL2065;IL2067;IL2070;IL2072;IL2075;IL2077;IL2080;IL2087;IL2090;IL2091;IL2111;IL3000;IL3002;IL3050;IL3051</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" Exclude="Assets/Keys/**;Assets/Fonts/Source/**" />
    <!-- Source of the static Archivo instances; regenerate them with tools/make_archivo_instances.py. -->
    <None Include="Assets/Fonts/Source/**" />
    <EmbeddedResource Include="Assets/Keys/keys.bin" LogicalName="HikariHopper.keys.bin" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- FiveFury is consumed as a managed .NET library. -->
    <ProjectReference Include="$(FiveFuryRoot)FiveFury/FiveFury.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HikariHopper.Tests" />
  </ItemGroup>
</Project>
