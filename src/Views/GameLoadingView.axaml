<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HikariHopper.ViewModels"
             xmlns:v="using:HikariHopper.Views"
             xmlns:ui="using:HikariHopper.Ui"
             x:Class="HikariHopper.Views.GameLoadingView"
             x:DataType="vm:ExplorerViewModel"
             IsVisible="False" ZIndex="10"
             Background="{x:Static ui:Theme.WindowBg}">
  <!-- Shown 200ms into a game load: the common loading overlay, its train running while it shows, over the start
       page's background: its railway pattern, standing still where the start page's stopped, and a clearing behind
       the train and its caption, without the overlay's dim. -->
  <Panel>
    <v:RailPattern Name="Pattern" IsRunning="False" />
    <Border Name="PatternClearing" Width="640" Height="320" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
            Background="{x:Static ui:Theme.RailPatternClearing}" />
    <v:LoadingOverlay Name="Overlay" Background="Transparent" Title="{Binding GameLoadingStage}" Detail="{Binding GameLoadingName}" />
  </Panel>
</UserControl>
