<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HikariHopper.ViewModels"
             xmlns:v="using:HikariHopper.Views"
             xmlns:ui="using:HikariHopper.Ui"
             x:Class="HikariHopper.Views.GameLoadingView"
             x:DataType="vm:ExplorerViewModel"
             IsVisible="False" ZIndex="10"
             Background="{x:Static ui:Theme.AppBg}">
  <!-- Shown 200ms into a game load: the common loading overlay, its train running while it shows, on the list
       canvas, as the start page behind has nothing to show during a load. -->
  <v:LoadingOverlay Name="Overlay" Title="LOADING GAME" Detail="{Binding GameLoadingName}" />
</UserControl>
