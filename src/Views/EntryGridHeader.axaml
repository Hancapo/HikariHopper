<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HikariHopper.ViewModels"
             xmlns:v="using:HikariHopper.Views"
             xmlns:ui="using:HikariHopper.Ui"
             x:Class="HikariHopper.Views.EntryGridHeader"
             x:DataType="vm:ExplorerViewModel"
             Height="{x:Static ui:Theme.ListHeaderHeight}"
             Background="{x:Static ui:Theme.ListHeaderBg}">
  <!-- Port of EntryGridHeader.qml: compact sort buttons, styled like the details list's column header and
       starting where its NAME does. -->
  <Panel>
    <Grid ColumnDefinitions="Auto,68,68,*">
      <v:EntryTableHeaderCell Name="NameHeader" Grid.Column="0" Width="88" Text="NAME" LeftPadding="16" Clicked="OnSortName" />
      <v:EntryTableHeaderCell Name="TypeHeader" Grid.Column="1" Text="TYPE" LeftPadding="8" Clicked="OnSortType" />
      <v:EntryTableHeaderCell Name="SizeHeader" Grid.Column="2" Text="SIZE" LeftPadding="8" Clicked="OnSortSize" />
    </Grid>
  </Panel>
</UserControl>
