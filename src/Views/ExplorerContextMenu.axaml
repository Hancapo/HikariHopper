<c:RetroMenu xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HikariHopper.ViewModels"
             xmlns:v="using:HikariHopper.Views"
             xmlns:c="using:HikariHopper.Views.Controls"
             x:Class="HikariHopper.Views.ExplorerContextMenu"
             x:DataType="vm:ExplorerViewModel">
  <!-- Its DataContext is the tab's view model. Two menus in one, picked by Refresh when it opens: an item's
       (a folder, an archive or a file; or several) when something is selected, and the folder's own when
       nothing is, after a right-click on empty space. -->
  <c:RetroMenuItem Name="OpenItem" Text="Open" ShortcutText="Enter" IconName="external-link" Triggered="OnOpen" />
  <c:RetroMenuItem Name="OpenLocationItem" Text="Open location" ShortcutText="Ctrl+Enter" IconName="folder-input" Triggered="OnOpenLocation" />
  <c:RetroMenuItem Name="CopyItem" Text="Copy" ShortcutText="Ctrl+C" IconName="copy" Triggered="OnCopy" />
  <c:RetroMenuItem Name="CopyNameItem" Text="Copy name" IconName="file" Triggered="OnCopyName" />
  <c:RetroMenuItem Name="CopyPathItem" Text="Copy path" ShortcutText="Ctrl+Shift+C" IconName="link" Triggered="OnCopyPath" />
  <c:RetroMenuItem Name="RenameItem" Text="Rename…" ShortcutText="F2" IconName="pencil" Triggered="OnRename" />
  <c:RetroMenuSeparator Name="ExtractSeparator" />
  <c:RetroMenuItem Name="ExtractItem" Text="Extract…" IconName="download" Triggered="OnExtract" />
  <c:RetroMenuItem Name="ExtractContentItem" Text="Extract all content…" IconName="package-open" Triggered="OnExtractContent" />
  <c:RetroMenuSeparator Name="DeleteSeparator" />
  <c:RetroMenuItem Name="DeleteMenuItem" Text="Delete" ShortcutText="Del" IconName="trash-2" Triggered="OnDelete" />
  <c:RetroMenuSeparator Name="PropertiesSeparator" />
  <c:RetroMenuItem Name="PropertiesItem" Text="Properties" ShortcutText="Alt+Enter" IconName="info" Triggered="OnProperties" />

  <c:RetroMenuItem Name="NewEntryMenu" Text="New" IconName="plus">
    <c:RetroMenuItem Text="Folder" IconName="folder" Triggered="OnNewFolder" />
    <c:RetroMenuItem Name="CreateYtdMenuItem" Text="Texture dictionary" IconName="image" Triggered="OnNewYtd" />
    <c:RetroMenuSection Name="RpfArchiveSection" Text="RPF ARCHIVE" />
    <c:RetroMenuItem Name="CreateEmptyRpfMenuItem" Text="Empty" IconName="package-plus" Triggered="OnNewEmptyRpf" />
    <c:RetroMenuItem Name="CreateRpfFromFolderMenuItem" Text="From folder…" IconName="folder-input" Triggered="OnNewRpfFromFolder" />
    <c:RetroMenuItem Name="CreateRpfFromZipMenuItem" Text="From ZIP…" IconName="file-archive" Triggered="OnNewRpfFromZip" />
  </c:RetroMenuItem>
  <c:RetroMenuItem Name="PasteItem" Text="Paste" ShortcutText="Ctrl+V" IconName="clipboard" Triggered="OnPaste" />
  <c:RetroMenuSeparator Name="RefreshSeparator" />
  <c:RetroMenuItem Name="RefreshItem" Text="Refresh" ShortcutText="F5" IconName="rotate-cw" Triggered="OnRefresh" />
</c:RetroMenu>
