<v:ModalSheet xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:v="using:HikariHopper.Views"
              xmlns:c="using:HikariHopper.Views.Controls"
              xmlns:ui="using:HikariHopper.Ui"
              x:Class="HikariHopper.Views.SettingsDialog"
              x:DataType="v:SettingsDialog"
              WindowShare="0.6,0.74" MinSize="700,460" MaxSize="880,640"
              Heading="SETTINGS"
              BodyMargin="0"
              FooterText="Saved automatically">
  <!-- The groups in a sunken sidebar from the header to the footer, the chosen one raised, and the chosen group's
       page: its settings as rows on cards, a control at the right of each. The sidebar says which group it is, so
       the page has no title; a row's second line is only for what it holds now (a folder, a count). The page and the
       sidebar both start 16 px down, the page 16 px in from it and from the sheet's side. -->
  <v:ModalSheet.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="Foreground" Value="{x:Static ui:Theme.TextFaint}" />
      <Setter Property="FontFamily" Value="{x:Static ui:Theme.MonoFont}" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.2" />
    </Style>
  </v:ModalSheet.Styles>
  <Grid ColumnDefinitions="Auto,*">
    <Border Name="Sidebar" Width="192" Padding="12,16" Background="{x:Static ui:Theme.InsetBg}"
            BorderBrush="{x:Static ui:Theme.BorderHard}" BorderThickness="0,0,1,0">
      <StackPanel Spacing="2">
        <v:SettingsGroupRow Name="GamesGroup" Label="Games" Icon="box" Selected="True" />
        <v:SettingsGroupRow Name="StartupGroup" Label="Startup" Icon="zap" />
        <v:SettingsGroupRow Name="UpdatesGroup" Label="Updates" Icon="download" />
        <v:SettingsGroupRow Name="CacheGroup" Label="Cache" Icon="database" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1" Theme="{StaticResource BareScrollViewer}"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Panel Margin="16">
        <StackPanel Name="GamesPage">
          <StackPanel Name="GameRows" />
        </StackPanel>

        <StackPanel Name="StartupPage" IsVisible="False">
          <v:SettingsCard>
            <v:SettingsRow Title="Open the last game">
              <c:OnOffSwitch Name="OpenLastGame" />
            </v:SettingsRow>
            <v:SettingsRow Name="RecentRow" Title="Recent games on the start page">
              <c:ChromeToolButton Name="ClearRecents" Width="88" Height="28" Raised="True" Text="Clear list" />
            </v:SettingsRow>
          </v:SettingsCard>
        </StackPanel>

        <StackPanel Name="UpdatesPage" IsVisible="False">
          <v:SettingsCard>
            <v:SettingsRow Name="VersionRow">
              <c:ChromeToolButton Name="CheckNow" Width="104" Height="28" Raised="True" Text="Check now" />
            </v:SettingsRow>
            <v:SettingsRow Title="Check for updates at startup">
              <c:OnOffSwitch Name="CheckForUpdates" />
            </v:SettingsRow>
          </v:SettingsCard>
        </StackPanel>

        <StackPanel Name="CachePage" IsVisible="False">
          <v:SettingsCard>
            <v:SettingsRow Name="TexturesRow" Title="Texture index">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:ChromeToolButton Name="RebuildTextures" Width="96" Height="28" Raised="True" Text="Rebuild" />
                <c:ChromeToolButton Name="DeleteTextures" Width="96" Height="28" Raised="True" Text="Delete" />
              </StackPanel>
            </v:SettingsRow>
            <v:SettingsRow Name="SearchRow" Title="Search index">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:ChromeToolButton Name="RebuildSearch" Width="96" Height="28" Raised="True" Text="Rebuild" />
                <c:ChromeToolButton Name="DeleteSearch" Width="96" Height="28" Raised="True" Text="Delete" />
              </StackPanel>
            </v:SettingsRow>
          </v:SettingsCard>
          <DockPanel Margin="2,8,0,0">
            <c:ChromeToolButton Name="OpenCacheFolder" DockPanel.Dock="Right" Width="96" Height="28" Bordered="False" Text="Open folder" />
            <TextBlock Name="CacheFolderText" VerticalAlignment="Center" Foreground="{x:Static ui:Theme.TextFaint}"
                       FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="{x:Static ui:Theme.SmallFontSize}"
                       TextTrimming="LeadingCharacterEllipsis" />
          </DockPanel>
        </StackPanel>
      </Panel>
    </ScrollViewer>
  </Grid>
</v:ModalSheet>
