<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HikariHopper.ViewModels"
             xmlns:v="using:HikariHopper.Views"
             xmlns:ui="using:HikariHopper.Ui"
             x:Class="HikariHopper.Views.FolderPanel"
             x:DataType="vm:ExplorerViewModel">
  <!-- Port of FolderPanel.qml: the flattened folder tree with dotted depth guides and chevron
       toggles. Rows sit 6px inside the panel; the scrollbar floats over its right edge. -->
  <ScrollViewer Name="Scroller" Theme="{StaticResource QuietOverlayScrollViewer}" Margin="0,6">
    <v:FolderTreeList Name="FolderList" ItemsSource="{Binding TreeModel}" Focusable="True" IsTabStop="True"
                      Margin="{x:Static v:FolderPanel.RowInset}"
                      FocusAdorner="{x:Null}" AutomationProperties.Name="Archive folders">
      <v:FolderTreeList.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </v:FolderTreeList.ItemsPanel>
    </v:FolderTreeList>
  </ScrollViewer>
</UserControl>
