<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:HikariHopper.Views"
             xmlns:c="using:HikariHopper.Views.Controls"
             xmlns:ui="using:HikariHopper.Ui"
             x:Class="HikariHopper.Views.GamePathRow"
             x:DataType="v:GamePathRow">
  <!-- One installation in Settings, a row of its game's well: the edition's mark and name over its folder and
       whether the game's executable is in it, then Choose folder… (Change… once set) and a mark that clears it. -->
  <Grid Margin="14,11,12,11" ColumnDefinitions="Auto,*,Auto,Auto">
    <c:EditionMark Name="Mark" Width="18" Height="18" Margin="0,2,12,0" VerticalAlignment="Top" />
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <TextBlock Name="TitleText" Foreground="{x:Static ui:Theme.Text}"
                 FontFamily="{x:Static ui:Theme.UiFont}" FontSize="13" FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis" />
      <!-- Trimmed from the start: a long folder keeps its last folders, which name the game, and the check. -->
      <TextBlock Name="DetailText" Margin="0,4,0,0" TextTrimming="LeadingCharacterEllipsis"
                 FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="{x:Static ui:Theme.SmallFontSize}" />
    </StackPanel>
    <c:ChromeToolButton Name="BrowseButton" Grid.Column="2" Height="28" Margin="16,0,0,0" Raised="True"
                        VerticalAlignment="Center" />
    <c:ChromeToolButton Name="ClearButton" Grid.Column="3" Width="26" Height="26" Margin="4,0,0,0" VerticalAlignment="Center"
                        Bordered="False" CornerRadius="{x:Static ui:Theme.InnerCorner}"
                        IconKind="close" IconSize="11" IconThickness="1.4" />
  </Grid>
</UserControl>
