<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:HikariHopper.Views"
             xmlns:c="using:HikariHopper.Views.Controls"
             xmlns:ui="using:HikariHopper.Ui"
             x:Class="HikariHopper.Views.GamePathRow"
             x:DataType="v:GamePathRow">
  <!-- One installation in Settings, a row of its game's well: the edition's mark and name, with whether the game's
       executable is in its folder, over the folder; then a folder button that chooses it and a mark that clears it. -->
  <!-- The clear mark's column stays when it is hidden, so every row's folder button lines up. -->
  <Grid Margin="14,11,12,11" ColumnDefinitions="Auto,*,Auto,30">
    <c:EditionMark Name="Mark" Width="18" Height="18" Margin="0,2,12,0" VerticalAlignment="Top" />
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <!-- Both lines have a set height: the check's mono after the name would otherwise make the first a pixel
           taller once a folder is set, and the card would move. -->
      <TextBlock Name="TitleText" Foreground="{x:Static ui:Theme.Text}" LineHeight="17"
                 FontFamily="{x:Static ui:Theme.UiFont}" FontSize="13" FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis" />
      <!-- Trimmed from the start: a long folder keeps its last folders, which name the game. -->
      <TextBlock Name="DetailText" Margin="0,3,0,0" LineHeight="15" TextTrimming="LeadingCharacterEllipsis"
                 FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="{x:Static ui:Theme.SmallFontSize}" />
    </StackPanel>
    <c:ChromeToolButton Name="BrowseButton" Grid.Column="2" Width="32" Height="28" Margin="16,0,0,0" Raised="True"
                        VerticalAlignment="Center" IconKind="folder" IconSize="15" IconThickness="1.5" />
    <c:ChromeToolButton Name="ClearButton" Grid.Column="3" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Bordered="False" CornerRadius="{x:Static ui:Theme.InnerCorner}"
                        IconKind="close" IconSize="11" IconThickness="1.4" />
  </Grid>
</UserControl>
