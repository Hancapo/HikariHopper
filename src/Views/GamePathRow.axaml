<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:HikariHopper.Views"
             xmlns:c="using:HikariHopper.Views.Controls"
             xmlns:ui="using:HikariHopper.Ui"
             x:Class="HikariHopper.Views.GamePathRow"
             x:DataType="v:GamePathRow">
  <!-- One installation in Settings: the edition's mark and name, its folder, Browse… and a mark that
       clears it, and under the folder a plain line saying whether the game's executable is there. -->
  <Grid Margin="10,6,8,6" ColumnDefinitions="18,72,*,Auto,Auto" RowDefinitions="28,Auto" ColumnSpacing="9">
    <c:EditionMark Name="Mark" Width="16" Height="16" VerticalAlignment="Center" />
    <TextBlock Name="TitleText" Grid.Column="1" VerticalAlignment="Center" Foreground="{x:Static ui:Theme.Text}"
               FontFamily="{x:Static ui:Theme.UiFont}" FontSize="13" FontWeight="SemiBold"
               TextTrimming="CharacterEllipsis" />
    <c:FlatTextField Name="PathField" Grid.Column="2" Height="28" PlaceholderText="Select the installation folder" />
    <c:ChromeToolButton Name="BrowseButton" Grid.Column="3" Width="78" Height="28" Raised="True" Text="Browse…" />
    <c:ChromeToolButton Name="ClearButton" Grid.Column="4" Width="24" Height="24" VerticalAlignment="Center"
                        Bordered="False" CornerRadius="{x:Static ui:Theme.InnerCorner}"
                        IconKind="close" IconSize="11" IconThickness="1.4" />
    <TextBlock Name="StatusText" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Margin="2,5,0,0"
               FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="{x:Static ui:Theme.SmallFontSize}" />
  </Grid>
</UserControl>
