<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:HikariHopper.Views.Controls"
             xmlns:ui="using:HikariHopper.Ui"
             x:Class="HikariHopper.Views.TexturePreviewToolbar"
             Height="{x:Static ui:Theme.TextureToolbarHeight}"
             Background="{x:Static ui:Theme.ChromeBg}">
  <!-- The bar above the texture preview, in the navigation bar's segmented wells: what you see
       (the channels, each letter in its own colour), the transparency grid toggle, the Smooth /
       Pixels switch, and how big (the Fit / 1:1 switch, and zoom out / the zoom, which opens presets / in). -->
  <UserControl.Styles>
    <Style Selector="Border.well">
      <Setter Property="Background" Value="{x:Static ui:Theme.InsetBg}" />
      <Setter Property="CornerRadius" Value="{x:Static ui:Theme.ControlCorner}" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.well > StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="2" />
    </Style>
    <Style Selector="c|ChromeToolButton">
      <Setter Property="Height" Value="24" />
      <Setter Property="MinWidth" Value="26" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Bordered" Value="False" />
      <Setter Property="InWell" Value="True" />
      <Setter Property="CornerRadius" Value="{x:Static ui:Theme.InnerCorner}" />
      <Setter Property="IconSize" Value="14" />
      <Setter Property="IconThickness" Value="1.5" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <Border Height="1" VerticalAlignment="Bottom" Background="{x:Static ui:Theme.BorderHard}" />
    <StackPanel Margin="12,0,8,0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <!-- Switches: the channel, each letter in its own colour; the raised segment slides to the one shown. -->
      <c:SegmentedSwitch Name="ChannelSwitch">
        <c:SwitchSide Text="RGBA" Width="46" Label="All channels" />
        <c:SwitchSide Text="R" Width="26" Label="Red channel" Ink="#E8837E" DimInk="#B8E8837E" />
        <c:SwitchSide Text="G" Width="26" Label="Green channel" Ink="#98D684" DimInk="#B898D684" />
        <c:SwitchSide Text="B" Width="26" Label="Blue channel" Ink="#7FAEEE" DimInk="#B87FAEEE" />
        <c:SwitchSide Text="A" Width="26" Label="Alpha channel" Ink="#C6C8DA" DimInk="#B8C6C8DA" />
      </c:SegmentedSwitch>
      <!-- A toggle of its own: the transparency grid is on or off. -->
      <Border Classes="well">
        <StackPanel>
          <c:ChromeToolButton Name="CheckerboardButton" Width="28" IconKind="checkerboard"
                              AutomationProperties.Name="Transparency grid" />
        </StackPanel>
      </Border>
      <!-- Smooth or Pixels, and Fit or actual size: switches too. -->
      <c:SegmentedSwitch Name="FilterSwitch">
        <c:SwitchSide Icon="smooth" Label="Smooth" />
        <c:SwitchSide Icon="pixels" Label="Pixels" />
      </c:SegmentedSwitch>
      <c:SegmentedSwitch Name="FitSwitch">
        <c:SwitchSide Text="Fit" Width="38" Label="Fit the texture" ToolTip="Fit to the view  (F)" />
        <c:SwitchSide Text="1:1" Width="34" Label="Actual size" ToolTip="Actual size  (1)" />
      </c:SegmentedSwitch>
      <Border Classes="well">
        <StackPanel>
          <c:ChromeToolButton Name="ZoomOutButton" Width="26" IconKind="minus" AutomationProperties.Name="Zoom out" />
          <Panel>
            <c:ChromeToolButton Name="ZoomButton" Width="68" Padding="0,0,10,0"
                                AutomationProperties.Name="Zoom presets" />
            <c:LucideIcon IconName="chevron-down" Width="9" Height="9" Margin="0,0,8,0" Weight="1.6"
                          HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                          Stroke="{x:Static ui:Theme.TextDim}" />
          </Panel>
          <c:ChromeToolButton Name="ZoomInButton" Width="26" IconKind="plus" AutomationProperties.Name="Zoom in" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Panel>
</UserControl>
