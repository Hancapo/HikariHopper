<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:HikariHopper.Views.Controls"
             xmlns:ui="using:HikariHopper.Ui"
             x:Class="HikariHopper.Views.TexturePreviewToolbar"
             Height="{x:Static ui:Theme.TextureToolbarHeight}"
             Background="{x:Static ui:Theme.ChromeBg}">
  <!-- The bar above the texture preview, in the navigation bar's segmented wells: what you see
       (the channels, each letter in its own colour), the transparency grid toggle, the Smooth /
       Pixels switch, and how big (fit, actual size, and zoom out / the zoom, which opens presets / in). -->
  <UserControl.Styles>
    <Style Selector="Border.well">
      <Setter Property="Background" Value="{x:Static ui:Theme.InsetBg}" />
      <Setter Property="CornerRadius" Value="{x:Static ui:Theme.ControlCorner}" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.well > StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="2" />
    </Style>
    <Style Selector="c|ChromeToolButton">
      <Setter Property="Height" Value="24" />
      <Setter Property="MinWidth" Value="26" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Bordered" Value="False" />
      <Setter Property="InWell" Value="True" />
      <Setter Property="CornerRadius" Value="{x:Static ui:Theme.InnerCorner}" />
      <Setter Property="IconSize" Value="14" />
      <Setter Property="IconThickness" Value="1.5" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <Border Height="1" VerticalAlignment="Bottom" Background="{x:Static ui:Theme.BorderHard}" />
    <StackPanel Margin="12,0,8,0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Border Classes="well">
        <StackPanel>
          <c:ChromeToolButton Name="RgbaButton" Width="46" Text="RGBA" AutomationProperties.Name="Show RGBA channels" />
          <c:ChromeToolButton Name="RedButton" Width="26" Text="R" AutomationProperties.Name="Show the red channel" />
          <c:ChromeToolButton Name="GreenButton" Width="26" Text="G" AutomationProperties.Name="Show the green channel" />
          <c:ChromeToolButton Name="BlueButton" Width="26" Text="B" AutomationProperties.Name="Show the blue channel" />
          <c:ChromeToolButton Name="AlphaButton" Width="26" Text="A" AutomationProperties.Name="Show the alpha channel" />
        </StackPanel>
      </Border>
      <!-- A toggle of its own: the transparency grid is on or off. -->
      <Border Classes="well">
        <StackPanel>
          <c:ChromeToolButton Name="CheckerboardButton" Width="28" IconKind="checkerboard"
                              AutomationProperties.Name="Transparency grid" />
        </StackPanel>
      </Border>
      <!-- One switch with two sides: a single track, and a thumb that slides to the side in use. -->
      <Border Name="FilterSwitch" Classes="well" Cursor="Hand" Background="{x:Static ui:Theme.InsetBg}">
        <Panel Width="56" Height="24">
          <Border Name="FilterThumb" Width="28" HorizontalAlignment="Left"
                  CornerRadius="{x:Static ui:Theme.InnerCorner}" Background="{x:Static ui:Theme.ChromeRaised}"
                  BoxShadow="0 1 0 0 #12FFFBFF inset" />
          <Grid ColumnDefinitions="*,*" IsHitTestVisible="False">
            <c:ChromeIcon Name="SmoothIcon" Kind="smooth" Width="14" Height="14" Thickness="1.5"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            <c:ChromeIcon Name="PixelsIcon" Grid.Column="1" Kind="pixels" Width="14" Height="14" Thickness="1.5"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Panel>
      </Border>
      <Border Classes="well">
        <StackPanel>
          <c:ChromeToolButton Name="FitButton" Width="38" Text="Fit" AutomationProperties.Name="Fit the texture" />
          <c:ChromeToolButton Name="ActualSizeButton" Width="34" Text="1:1" AutomationProperties.Name="Actual size" />
        </StackPanel>
      </Border>
      <Border Classes="well">
        <StackPanel>
          <c:ChromeToolButton Name="ZoomOutButton" Width="26" IconKind="minus" AutomationProperties.Name="Zoom out" />
          <Panel>
            <c:ChromeToolButton Name="ZoomButton" Width="68" Padding="0,0,10,0"
                                AutomationProperties.Name="Zoom presets" />
            <c:LucideIcon IconName="chevron-down" Width="9" Height="9" Margin="0,0,8,0" Weight="1.6"
                          HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                          Stroke="{x:Static ui:Theme.TextDim}" />
          </Panel>
          <c:ChromeToolButton Name="ZoomInButton" Width="26" IconKind="plus" AutomationProperties.Name="Zoom in" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Panel>
</UserControl>
