<c:RetroMenu xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:HikariHopper.Views.Controls"
             xmlns:vm="using:HikariHopper.ViewModels"
             x:Class="HikariHopper.Views.TextureContextMenu"
             x:DataType="vm:TextureViewerViewModel">
  <!-- The texture rail's menu: the clipboard and replacing first, then editing (resize and format each
       open their two ways), then the texture's own actions, removing last. -->
  <c:RetroMenuItem Name="CopyItem" Text="Copy image" ShortcutText="Ctrl+C" IconName="copy" IsEnabled="{Binding CanEditSingle}" />
  <c:RetroMenuItem Name="PasteItem" Text="Paste…" ShortcutText="Ctrl+V" IconName="clipboard" IsEnabled="{Binding CanPasteImage}" />
  <c:RetroMenuItem Name="ReplaceItem" Text="Replace from image…" IconName="image" IsEnabled="{Binding CanEditSingle}" />
  <c:RetroMenuSeparator />
  <c:RetroMenuItem Name="ResizeMenu" Text="Resize" IconName="scaling" IsEnabled="{Binding CanEditSelection}">
    <c:RetroMenuItem Name="ResizeItem" Text="To a size…" IsEnabled="{Binding CanEditSelection}" />
    <c:RetroMenuItem Name="PowerOfTwoItem" Text="To power of 2…" IsEnabled="{Binding CanResizeToPowerOfTwo}" />
  </c:RetroMenuItem>
  <c:RetroMenuItem Name="MipmapsItem" Text="Recalculate mipmaps…" IconName="layers" IsEnabled="{Binding CanEditSelection}" />
  <c:RetroMenuItem Name="FormatMenu" Text="Format" IconName="file-cog" IsEnabled="{Binding CanEditSelection}">
    <c:RetroMenuItem Name="FormatItem" Text="Change format…" IsEnabled="{Binding CanEditSelection}" />
    <c:RetroMenuItem Name="OptimizeItem" Text="Optimize compression" IconName="zap" IsEnabled="{Binding CanOptimizeSelection}" />
  </c:RetroMenuItem>
  <c:RetroMenuSeparator />
  <c:RetroMenuItem Name="ExtractItem" Text="Extract DDS…" ShortcutText="Ctrl+E" IconName="download" IsEnabled="{Binding CanExtractSelection}" />
  <c:RetroMenuItem Name="RenameItem" Text="Rename…" ShortcutText="F2" IconName="pencil" IsEnabled="{Binding CanEditSingle}" />
  <c:RetroMenuItem Name="RemoveItem" Text="Remove" ShortcutText="Del" IconName="trash-2" IsEnabled="{Binding CanRemove}" />
</c:RetroMenu>
