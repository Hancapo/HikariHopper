<v:TextureToolDialog xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:v="using:HikariHopper.Views"
                     xmlns:c="using:HikariHopper.Views.Controls"
                     x:Class="HikariHopper.Views.TextureFormatDialog"
                     Heading="CHANGE FORMAT">
  <!-- Converts the selection to another storage format: the format, with what it costs and keeps beside each; how
       hard it is compressed, for the formats that are; and its mipmaps. Then what it is now beside what it would be.
       A row's gap is its own top margin, so a row that is hidden takes none. -->
  <c:QtColumnLayout Margin="12,12,12,13" Spacing="10">
    <v:TextureDialogSummary Name="Summary" Fact="Format" />
    <Border Classes="rule" />
    <v:QtGrid ColumnDefinitions="112,12,*" RowDefinitions="Auto,Auto,Auto">
      <TextBlock Classes="label" Text="Format" />
      <c:FlatComboBox Name="FormatCombo" Grid.Column="2" />
      <TextBlock Name="QualityLabel" Classes="label" Grid.Row="1" Margin="0,8,0,0" Text="Quality" />
      <c:SegmentedSwitch Name="QualitySwitch" Grid.Row="1" Grid.Column="2" Margin="0,8,0,0" Height="28"
                         HorizontalAlignment="Left" AutomationProperties.Name="Quality" />
      <TextBlock Classes="label" Grid.Row="2" Margin="0,8,0,0" Text="Mipmaps" />
      <v:TextureMipChainCombo Name="MipCombo" Grid.Row="2" Grid.Column="2" Margin="0,8,0,0" />
    </v:QtGrid>
    <v:TextureOutcome Name="Outcome" />
  </c:QtColumnLayout>
</v:TextureToolDialog>
