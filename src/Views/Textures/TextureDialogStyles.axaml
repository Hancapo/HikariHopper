<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:HikariHopper.Views"
        xmlns:ui="using:HikariHopper.Ui">
  <!-- The repeated pieces of the texture tool dialogs' QML bodies. -->

  <!-- Text { color: textFaint; font.family: uiFont; font.pixelSize: fontSize } in a grid cell. -->
  <Style Selector=":is(v|TextureModalDialog) TextBlock.label">
    <Setter Property="Foreground" Value="{x:Static ui:Theme.TextFaint}" />
    <Setter Property="FontFamily" Value="{x:Static ui:Theme.UiFont}" />
    <Setter Property="FontSize" Value="{x:Static ui:Theme.FontSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <!-- A sunken well for a toggle: on, the button sits raised in it. -->
  <Style Selector=":is(v|TextureModalDialog) Border.well">
    <Setter Property="Background" Value="{x:Static ui:Theme.InsetBg}" />
    <Setter Property="CornerRadius" Value="{x:Static ui:Theme.ControlCorner}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Rectangle { Layout.preferredHeight: 1; color: border } -->
  <Style Selector=":is(v|TextureModalDialog) Border.rule">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{x:Static ui:Theme.Border}" />
  </Style>

  <!-- The RESULT well: insetBg with a border line, the caption at (9, 4). -->
  <Style Selector=":is(v|TextureModalDialog) Border.result">
    <Setter Property="Background" Value="{x:Static ui:Theme.InsetBg}" />
    <Setter Property="BorderBrush" Value="{x:Static ui:Theme.Border}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector=":is(v|TextureModalDialog) TextBlock.caption">
    <Setter Property="Margin" Value="9,4,0,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Foreground" Value="{x:Static ui:Theme.TextFaint}" />
    <Setter Property="FontFamily" Value="{x:Static ui:Theme.MonoFont}" />
    <Setter Property="FontSize" Value="{x:Static ui:Theme.SmallFontSize}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1" />
  </Style>
  <Style Selector=":is(v|TextureModalDialog) TextBlock.result">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Foreground" Value="{x:Static ui:Theme.TextRow}" />
    <Setter Property="FontFamily" Value="{x:Static ui:Theme.MonoFont}" />
    <Setter Property="FontSize" Value="{x:Static ui:Theme.FontSize}" />
  </Style>

  <!-- Body copy: Text { color: textRow; font.family: uiFont; wrapMode: WordWrap } -->
  <Style Selector=":is(v|TextureModalDialog) TextBlock.body">
    <Setter Property="Foreground" Value="{x:Static ui:Theme.TextRow}" />
    <Setter Property="FontFamily" Value="{x:Static ui:Theme.UiFont}" />
    <Setter Property="FontSize" Value="{x:Static ui:Theme.FontSize}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</Styles>
