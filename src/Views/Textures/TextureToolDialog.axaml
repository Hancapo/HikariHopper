<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="using:HikariHopper.Views"
                    xmlns:c="using:HikariHopper.Views.Controls"
                    xmlns:ui="using:HikariHopper.Ui">
  <!-- Port of TextureToolDialog.qml: a rounded card with header, body and footer, its hard
       border drawn over all three. -->
  <ControlTheme x:Key="{x:Type v:TextureToolDialog}" TargetType="v:TextureToolDialog">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{x:Static ui:Theme.AppBg}" BorderBrush="{x:Static ui:Theme.Border}" BorderThickness="1"
                CornerRadius="{x:Static ui:Theme.SheetCorner}" BoxShadow="{x:Static ui:Theme.SheetShadow}">
        <c:RoundedClip Radius="{x:Static ui:Theme.SheetInnerRadius}">
          <DockPanel>
            <Panel DockPanel.Dock="Top" Height="{x:Static ui:Theme.SheetHeaderHeight}" Background="{x:Static ui:Theme.ChromeRaised}">
              <Border Height="1" VerticalAlignment="Bottom" Background="{x:Static ui:Theme.BorderHard}" />
              <TextBlock Margin="16,0,44,0" VerticalAlignment="Center" Text="{TemplateBinding Heading}"
                         Foreground="{x:Static ui:Theme.TextRow}" FontWeight="Bold" LetterSpacing="1.2"
                         FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="{x:Static ui:Theme.SmallFontSize}"
                         TextTrimming="CharacterEllipsis" />
              <c:ChromeToolButton Name="PART_CloseMark" Width="26" Height="26" Margin="0,0,8,0" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Bordered="False" CornerRadius="{x:Static ui:Theme.InnerCorner}"
                                  IconKind="close" IconSize="12" IconThickness="1.4" IsTabStop="False"
                                  AutomationProperties.Name="Cancel" />
            </Panel>
            <Panel DockPanel.Dock="Bottom" Height="{x:Static ui:Theme.DialogFooterHeight}" Background="{x:Static ui:Theme.ChromeBg}">
              <Border Height="1" VerticalAlignment="Top" Background="{x:Static ui:Theme.BorderHard}" />
              <StackPanel Margin="0,0,12,0" Orientation="Horizontal" Spacing="6"
                          HorizontalAlignment="Right" VerticalAlignment="Center">
                <c:ChromeToolButton Name="PART_CancelButton" Width="88" Height="28" Raised="True" Text="Cancel" />
                <c:ChromeToolButton Name="PART_ApplyButton" Width="88" Height="28" Primary="True"
                                    Text="{TemplateBinding ApplyLabel}" />
              </StackPanel>
            </Panel>
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              AutomationProperties.Name="{TemplateBinding Heading}" />
          </DockPanel>
        </c:RoundedClip>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
