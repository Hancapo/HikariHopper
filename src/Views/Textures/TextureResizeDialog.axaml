<v:TextureToolDialog xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:v="using:HikariHopper.Views"
                     xmlns:c="using:HikariHopper.Views.Controls"
                     xmlns:ui="using:HikariHopper.Ui"
                     x:Class="HikariHopper.Views.TextureResizeDialog"
                     Heading="RESIZE TEXTURE">
  <!-- Resizes the selection. One Size row: the width and the height with the aspect lock between them, and at its end
       whether they are pixels or percent; under it, the sizes asked for most often. Then how it is resampled and what
       mipmaps it gets, and what it is now beside what it would be. -->
  <c:QtColumnLayout Margin="12,12,12,13" Spacing="10">
    <v:TextureDialogSummary Name="Summary" Fact="Size" />
    <Border Classes="rule" />
    <v:QtGrid Name="OptionsGrid" ColumnDefinitions="112,12,*" RowDefinitions="Auto,6,Auto,8,Auto,8,Auto">
      <TextBlock Classes="label" Text="Size" />
      <v:QtGrid Grid.Column="2" ColumnDefinitions="*,6,Auto,6,*,8,Auto">
        <c:FlatTextField Name="WidthField" Grid.Column="0" Height="28" VerticalAlignment="Center"
                         AutomationProperties.Name="Width" />
        <Border Grid.Column="2" Classes="well">
          <c:ChromeToolButton Name="LockButton" Width="24" Height="24" Bordered="False" InWell="True"
                              CornerRadius="{x:Static ui:Theme.InnerCorner}" IconKind="link" IconSize="13" IconThickness="1.7"
                              AutomationProperties.Name="Lock aspect ratio" />
        </Border>
        <c:FlatTextField Name="HeightField" Grid.Column="4" Height="28" VerticalAlignment="Center"
                         AutomationProperties.Name="Height" />
        <c:SegmentedSwitch Name="UnitSwitch" Grid.Column="6" Height="28" VerticalAlignment="Center"
                           AutomationProperties.Name="Size in" />
      </v:QtGrid>

      <StackPanel Name="QuickSizes" Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Spacing="4">
        <c:ChromeToolButton Name="QuarterButton" Classes="quick" Width="44" Text="25%" AutomationProperties.Name="A quarter of the size" />
        <c:ChromeToolButton Name="HalfButton" Classes="quick" Width="44" Text="50%" AutomationProperties.Name="Half the size" />
        <c:ChromeToolButton Name="DoubleButton" Classes="quick" Width="50" Text="200%" AutomationProperties.Name="Double the size" />
        <c:ChromeToolButton Name="SnapButton" Classes="quick" Width="104" Text="Power of two" AutomationProperties.Name="Round to a power of two" />
      </StackPanel>

      <TextBlock Classes="label" Grid.Row="4" Text="Resampling" />
      <v:TextureFilterCombo Name="FilterCombo" Grid.Row="4" Grid.Column="2" />

      <TextBlock Classes="label" Grid.Row="6" Text="Mipmaps" />
      <v:TextureMipChainCombo Name="MipCombo" Grid.Row="6" Grid.Column="2" />
    </v:QtGrid>
    <v:TextureOutcome Name="Outcome" />
  </c:QtColumnLayout>
</v:TextureToolDialog>
