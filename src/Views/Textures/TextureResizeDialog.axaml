<v:TextureToolDialog xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:v="using:HikariHopper.Views"
                     xmlns:c="using:HikariHopper.Views.Controls"
                     xmlns:ui="using:HikariHopper.Ui"
                     x:Class="HikariHopper.Views.TextureResizeDialog"
                     BodyHeight="330">
  <!-- Port of TextureResizeDialog.qml: free resize, or power-of-two rounding with PowerOfTwo. The
       grid rows of the other mode are hidden and take no space, as in a Qt GridLayout. -->
  <c:QtColumnLayout Margin="12" Spacing="10">
    <v:TextureDialogSummary />
    <Border Classes="rule" />
    <v:QtGrid Name="OptionsGrid" ColumnDefinitions="Auto,12,*"
          RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto">
      <TextBlock Name="ResolutionLabel" Classes="label" Text="Resolution" />
      <v:QtGrid Name="ResolutionRow" Grid.Column="2" ColumnDefinitions="*,8,Auto,8,*">
        <c:FlatTextField Name="WidthField" Grid.Column="0" Height="28" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="×" VerticalAlignment="Center" Foreground="{x:Static ui:Theme.TextDim}"
                   FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="{x:Static ui:Theme.FontSize}" />
        <c:FlatTextField Name="HeightField" Grid.Column="4" Height="28" VerticalAlignment="Center" />
      </v:QtGrid>

      <Panel Name="LockSpacer" Grid.Row="2" Width="112" Height="1" HorizontalAlignment="Left" VerticalAlignment="Center" />
      <c:SquareCheckBox Name="LockAspect" Grid.Row="2" Grid.Column="2" Text="Lock aspect ratio" IsChecked="True" />

      <TextBlock Name="RoundingLabel" Classes="label" Grid.Row="4" Text="Rounding" />
      <c:FlatComboBox Name="RoundingCombo" Grid.Row="4" Grid.Column="2" />

      <TextBlock Name="RoundingNote" Grid.Row="6" Grid.ColumnSpan="3"
                 Text="Each dimension is rounded separately; proportions may change."
                 Foreground="{x:Static ui:Theme.TextDim}" TextWrapping="Wrap"
                 FontFamily="{x:Static ui:Theme.UiFont}" FontSize="{x:Static ui:Theme.SmallFontSize}" />

      <TextBlock Classes="label" Grid.Row="8" Text="Resampling" />
      <v:TextureFilterCombo Name="FilterCombo" Grid.Row="8" Grid.Column="2" />

      <TextBlock Classes="label" Grid.Row="10" Text="Mipmaps" />
      <c:SquareCheckBox Name="MipCheck" Grid.Row="10" Grid.Column="2" Text="Recalculate full chain" IsChecked="True" />

      <TextBlock Name="SmallestLabel" Classes="label" Grid.Row="12" Text="Smallest level" />
      <v:TextureMipSizeCombo Name="MipSizeCombo" Grid.Row="12" Grid.Column="2" />
    </v:QtGrid>
    <Panel Height="56">
      <Border Classes="result" />
      <TextBlock Classes="caption" Text="RESULT" />
      <TextBlock Name="ResultText" Classes="result" Margin="9,25,9,0" TextTrimming="CharacterEllipsis" />
    </Panel>
    <Panel c:QtColumnLayout.FillHeight="True" />
  </c:QtColumnLayout>
</v:TextureToolDialog>
