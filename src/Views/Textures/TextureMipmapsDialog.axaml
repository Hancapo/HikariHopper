<v:TextureToolDialog xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:v="using:HikariHopper.Views"
                     xmlns:c="using:HikariHopper.Views.Controls"
                     x:Class="HikariHopper.Views.TextureMipmapsDialog"
                     Heading="MIPMAPS">
  <!-- Makes the selection's mip chain again: how far down it goes (or not at all) and how it is resampled, the two
       rows Resize ends with. Then the chain it has now beside the one it would have. -->
  <c:QtColumnLayout Margin="12,12,12,13" Spacing="10">
    <v:TextureDialogSummary Name="Summary" Fact="Mips" />
    <Border Classes="rule" />
    <v:QtGrid ColumnDefinitions="112,12,*" RowDefinitions="Auto,8,Auto">
      <TextBlock Classes="label" Text="Mipmaps" />
      <v:TextureMipChainCombo Name="MipCombo" Grid.Column="2" />
      <TextBlock Classes="label" Grid.Row="2" Text="Resampling" />
      <v:TextureFilterCombo Name="FilterCombo" Grid.Row="2" Grid.Column="2" />
    </v:QtGrid>
    <v:TextureOutcome Name="Outcome" />
  </c:QtColumnLayout>
</v:TextureToolDialog>
