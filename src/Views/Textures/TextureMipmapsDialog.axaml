<v:TextureToolDialog xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:v="using:HikariHopper.Views"
                     xmlns:c="using:HikariHopper.Views.Controls"
                     x:Class="HikariHopper.Views.TextureMipmapsDialog"
                     Heading="RECALCULATE MIPMAPS" BodyHeight="250">
  <!-- Port of TextureMipmapsDialog.qml. -->
  <c:QtColumnLayout Margin="12" Spacing="10">
    <v:TextureDialogSummary />
    <Border Classes="rule" />
    <v:QtGrid ColumnDefinitions="112,12,*" RowDefinitions="Auto,8,Auto">
      <TextBlock Classes="label" Text="Downsampling" />
      <v:TextureFilterCombo Name="FilterCombo" Grid.Column="2" />
      <TextBlock Classes="label" Grid.Row="2" Text="Smallest level" />
      <v:TextureMipSizeCombo Name="MipSizeCombo" Grid.Row="2" Grid.Column="2" />
    </v:QtGrid>
    <Panel Height="56">
      <Border Classes="result" />
      <TextBlock Classes="caption" Text="RESULT" />
      <TextBlock Name="ResultText" Classes="result" Margin="9,25,9,0" />
    </Panel>
    <Panel c:QtColumnLayout.FillHeight="True" />
  </c:QtColumnLayout>
</v:TextureToolDialog>
