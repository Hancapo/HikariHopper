<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:HikariHopper.Views"
             xmlns:c="using:HikariHopper.Views.Controls"
             xmlns:ui="using:HikariHopper.Ui"
             x:Class="HikariHopper.Views.TextureDialogSummary">
  <!-- One line: the texture glyph, the selection's name, and at the right the one thing about it the tool changes
       (its size, its format, its mips). -->
  <v:QtGrid ColumnDefinitions="16,10,*,Auto">
    <c:LucideIcon Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" IconName="image"
                  Stroke="{x:Static ui:Theme.InkAsset}" />
    <TextBlock Name="NameText" Grid.Column="2" Foreground="{x:Static ui:Theme.Text}" FontWeight="Bold"
               FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="{x:Static ui:Theme.FontSize}"
               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    <TextBlock Name="FactText" Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center"
               Foreground="{x:Static ui:Theme.TextDim}"
               FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="{x:Static ui:Theme.SmallFontSize}" />
  </v:QtGrid>
</UserControl>
