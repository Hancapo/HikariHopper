<v:TextureToolDialog xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:v="using:HikariHopper.Views"
                     xmlns:c="using:HikariHopper.Views.Controls"
                     x:Class="HikariHopper.Views.TextureRemoveDialog"
                     BodyHeight="160" ApplyLabel="Remove" Destructive="True">
  <!-- Port of TextureRemoveDialog.qml. -->
  <c:QtColumnLayout Margin="12" Spacing="10">
    <v:TextureDialogSummary />
    <Border Classes="rule" />
    <TextBlock Name="QuestionText" Classes="body" />
    <Panel c:QtColumnLayout.FillHeight="True" />
  </c:QtColumnLayout>
</v:TextureToolDialog>
