<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:HikariHopper.Views.Controls"
             xmlns:vm="using:HikariHopper.ViewModels"
             xmlns:ui="using:HikariHopper.Ui"
             x:Class="HikariHopper.Views.TextureViewerMenuRow"
             x:DataType="vm:TextureViewerViewModel"
             Height="{x:Static ui:Theme.MenuHeight}"
             Background="{x:Static ui:Theme.ChromeBg}">
  <!-- Port of TextureViewerMenuRow.qml: File and Edit titles, each opening a RetroMenu one pixel
       above the row's bottom seam. -->
  <UserControl.Resources>
    <c:RetroMenu x:Key="EditMenu" x:DataType="vm:TextureViewerViewModel">
      <c:RetroMenuItem ShortcutText="Ctrl+Z" IsEnabled="{Binding CanUndo}" />
      <c:RetroMenuSeparator />
      <c:RetroMenuItem Text="Remove duplicates by name"
                       IsEnabled="{Binding CanRemoveDuplicates}" />
      <c:RetroMenuSeparator />
      <c:RetroMenuItem Text="Paste…" ShortcutText="Ctrl+V" IsEnabled="{Binding CanPasteImage}" />
    </c:RetroMenu>
    <c:RetroMenu x:Key="FileMenu" x:DataType="vm:TextureViewerViewModel">
      <c:RetroMenuItem ShortcutText="Ctrl+S" IsEnabled="{Binding CanSave}" />
      <c:RetroMenuItem ShortcutText="Ctrl+Shift+S" IsEnabled="{Binding CanSaveAs}" />
      <c:RetroMenuSeparator />
      <c:RetroMenuItem Text="Import images…" ShortcutText="Ctrl+I" IsEnabled="{Binding CanImportImages}" />
      <c:RetroMenuItem Text="Extract all textures…" IsEnabled="{Binding CanExtractAll}" />
      <c:RetroMenuSeparator />
      <c:RetroMenuItem Text="Close" ShortcutText="Ctrl+W" />
    </c:RetroMenu>
  </UserControl.Resources>
  <Panel>
    <Border Height="1" VerticalAlignment="Bottom" Background="{x:Static ui:Theme.BorderHard}" />
    <StackPanel Margin="1,0,0,0" Orientation="Horizontal">
      <c:MenuBarButton Name="FileButton" Text="File" Padding="10,0" FontSize="13" />
      <c:MenuBarButton Name="EditButton" Text="Edit" Padding="10,0" FontSize="13" />
    </StackPanel>
  </Panel>
</UserControl>
