<v:TextureToolDialog xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:v="using:HikariHopper.Views"
                     xmlns:c="using:HikariHopper.Views.Controls"
                     xmlns:ui="using:HikariHopper.Ui"
                     x:Class="HikariHopper.Views.TextureRenameDialog"
                     Heading="RENAME TEXTURE" ApplyLabel="Rename">
  <!-- Renames the selected texture: the field holds its name, so there is no header to say it again. What is wrong
       with a name shows under the field while it is typed. -->
  <c:QtColumnLayout Margin="12,14,12,14" Spacing="7">
    <v:QtGrid ColumnDefinitions="112,12,*">
      <TextBlock Classes="label" Text="Name" />
      <c:FlatTextField Name="NameField" Grid.Column="2" Height="28" MaxLength="255" AutomationProperties.Name="Texture name" />
    </v:QtGrid>
    <Panel Name="ErrorHost" Margin="124,0,0,0" IsVisible="False" />
  </c:QtColumnLayout>
</v:TextureToolDialog>
