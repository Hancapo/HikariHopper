<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:HikariHopper.Views"
        xmlns:c="using:HikariHopper.Views.Controls"
        xmlns:ui="using:HikariHopper.Ui"
        x:Class="HikariHopper.Views.MainWindow"
        x:DataType="v:MainWindow"
        Width="1360" Height="840" MinWidth="940" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{x:Static ui:Theme.WindowBg}"
        FontFamily="{x:Static ui:Theme.UiFont}"
        FontSize="{x:Static ui:Theme.FontSize}"
        Foreground="{x:Static ui:Theme.Text}"
        Title="HikariHopper — Modding Toolkit">
  <!-- Port of main.qml: the frameless window. It owns the title bar and the blue piping; the
       explorer puts its menus into the title row (the tab names the document, so no title text). -->
  <Panel>
    <DockPanel>
      <c:WindowTitleBar Name="TitleBar" DockPanel.Dock="Top" x:FieldModifier="public"
                        Height="{x:Static ui:Theme.MainTitleHeight}" Background="{x:Static ui:Theme.ChromeBg}"
                        ShowTitle="False" EmblemSize="16" Seams="False" ControlWidth="{x:Static ui:Theme.MainCaptionWidth}"
                        TitleText="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
      <!-- ExplorerScreen goes here (QML: ExplorerScreen { tabs: window.tabs }). -->
      <!-- What a modal blurs and dims; the title bar above stays live. -->
      <ContentControl Name="ExplorerScreenHost" x:FieldModifier="public" v:ModalOverlay.IsBackdrop="True" />
    </DockPanel>

    <c:WindowResizeFrame />
  </Panel>
</Window>
