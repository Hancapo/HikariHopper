<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:HikariHopper.Views"
             xmlns:c="using:HikariHopper.Views.Controls"
             xmlns:ui="using:HikariHopper.Ui"
             x:Class="HikariHopper.Views.ImageViewer"
             v:ModalOverlay.FillsWindow="True"
             Focusable="True"
             FontFamily="{x:Static ui:Theme.UiFont}"
             FontSize="{x:Static ui:Theme.FontSize}"
             Foreground="{x:Static ui:Theme.Text}">
  <!-- An image file, to look at, as a modal that fills the main window over its blurred explorer, in the
       text viewer's frame: a header naming the file with a close mark, the texture editor's own preview
       (channels, filtering, transparency grid, zoom, and the mip bar for a DDS), and the status bar. -->
  <UserControl.Styles>
    <Style Selector="TextBlock.status">
      <Setter Property="FontFamily" Value="{x:Static ui:Theme.MonoFont}" />
      <Setter Property="FontSize" Value="{x:Static ui:Theme.SmallFontSize}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{x:Static ui:Theme.TextDim}" />
    </Style>
    <Style Selector="TextBlock.key">
      <Setter Property="Foreground" Value="{x:Static ui:Theme.TextRow}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{x:Static ui:Theme.TextFaint}" />
    </Style>
  </UserControl.Styles>
  <Border Background="{x:Static ui:Theme.AppBg}"
          CornerRadius="{x:Static ui:Theme.SheetCorner}" BoxShadow="{x:Static ui:Theme.SheetShadow}">
    <c:RoundedClip Radius="{x:Static ui:Theme.SheetRadius}">
      <Panel>
        <DockPanel>
          <Panel DockPanel.Dock="Top" Height="{x:Static ui:Theme.WindowTitleHeight}" Background="{x:Static ui:Theme.ChromeRaised}">
            <Border Height="1" VerticalAlignment="Bottom" Background="{x:Static ui:Theme.BorderHard}" />
            <StackPanel Margin="12,0,44,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <c:FileGlyph Name="TitleGlyph" Width="13" Height="13" VerticalAlignment="Center" FileKind="PNG Image" />
              <TextBlock Name="TitleText" VerticalAlignment="Center" FontSize="{x:Static ui:Theme.SmallFontSize}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <c:ChromeToolButton Name="CloseMark" Width="24" Height="22" Margin="0,0,6,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Bordered="False"
                                CornerRadius="{x:Static ui:Theme.InnerCorner}" IconKind="close" IconSize="11" IconThickness="1.4"
                                AutomationProperties.Name="Close the image viewer" />
          </Panel>

          <Panel DockPanel.Dock="Bottom" Height="{x:Static ui:Theme.StatusHeight}" Background="{x:Static ui:Theme.ChromeBg}">
            <Border Height="1" VerticalAlignment="Top" Background="{x:Static ui:Theme.Border}" />
            <Grid Margin="0,1,0,0" ColumnDefinitions="Auto,Auto,*,Auto">
              <!-- What the image is on the left, as the explorer's status bar has its counts; the keys on the right,
                   as the texture editor's has them. -->
              <StackPanel Name="Facts" Grid.Column="0" Orientation="Horizontal" Spacing="14" Margin="10,0,12,0">
                <TextBlock Name="DimensionsText" Classes="status" />
                <TextBlock Name="MipsText" Classes="status" />
                <TextBlock Name="SizeText" Classes="status" />
                <TextBlock Name="FormatText" Classes="status" Foreground="{x:Static ui:Theme.InkData}" />
              </StackPanel>
              <Border Name="FactsSeam" Grid.Column="1" Width="2" Background="{x:Static ui:Theme.BorderHard}"
                      BorderBrush="{x:Static ui:Theme.Border}" BorderThickness="0,0,1,0" />
              <TextBlock Name="StatusText" Grid.Column="2" Classes="status" Margin="10,0,0,0"
                         Foreground="{x:Static ui:Theme.TextFaint}" TextTrimming="CharacterEllipsis" />
              <StackPanel Name="Hints" Grid.Column="3" Orientation="Horizontal" Spacing="14" Margin="10,0,24,0">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Classes="status key" Text="Wheel" />
                  <TextBlock Classes="status label" Text="Zoom" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Classes="status key" Text="Drag" />
                  <TextBlock Classes="status label" Text="Pan" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Classes="status key" Text="F" />
                  <TextBlock Classes="status label" Text="Fit" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Classes="status key" Text="1" />
                  <TextBlock Classes="status label" Text="Actual size" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Panel>

          <v:TexturePreview Name="Preview" />
        </DockPanel>

        <!-- The card's outline, drawn over the content so the content keeps the whole card. -->
        <Border BorderBrush="{x:Static ui:Theme.Border}" BorderThickness="1" CornerRadius="{x:Static ui:Theme.SheetCorner}"
                IsHitTestVisible="False" />
      </Panel>
    </c:RoundedClip>
  </Border>
</UserControl>
