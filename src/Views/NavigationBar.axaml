<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HikariHopper.ViewModels"
             xmlns:v="using:HikariHopper.Views"
             xmlns:c="using:HikariHopper.Views.Controls"
             xmlns:ui="using:HikariHopper.Ui"
             x:Class="HikariHopper.Views.NavigationBar"
             x:DataType="vm:ExplorerViewModel"
             Height="{x:Static ui:Theme.NavigationHeight}"
             Background="{x:Static ui:Theme.NavigationBg}">
  <!-- Port of NavigationBar.qml. The active tab flows into this toolbar from above. -->
  <UserControl.Styles>
    <!-- A sunken group: buttons sit inside it 2px apart, their corners stepped down to stay parallel. -->
    <Style Selector="Border.well">
      <Setter Property="Height" Value="{x:Static ui:Theme.ToolbarControlHeight}" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="{x:Static ui:Theme.ControlCorner}" />
      <Setter Property="Background" Value="{x:Static ui:Theme.InsetBg}" />
    </Style>
    <Style Selector="c|ChromeToolButton.segment">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Bordered" Value="False" />
      <Setter Property="InWell" Value="True" />
      <Setter Property="CornerRadius" Value="{x:Static ui:Theme.InnerCorner}" />
      <Setter Property="IconThickness" Value="1.5" />
    </Style>
    <Style Selector="c|ChromeToolButton.nav">
      <Setter Property="Foreground" Value="{x:Static ui:Theme.TextRow}" />
    </Style>
    <Style Selector="c|ChromeToolButton.nav:disabled">
      <Setter Property="Foreground" Value="{x:Static ui:Theme.TextFaint}" />
    </Style>
    <Style Selector="TextBlock.segment">
      <Setter Property="FontFamily" Value="{x:Static ui:Theme.MonoFont}" />
      <Setter Property="FontSize" Value="{x:Static ui:Theme.FontSize}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <Border Height="1" VerticalAlignment="Bottom" Background="{x:Static ui:Theme.BorderHard}" />

    <!-- 8px between the parts, each part's own left margin, so the view switch's gap goes with it when it slides away. -->
    <Grid Margin="10,0" ColumnDefinitions="Auto,*,Auto,Auto">
      <Border Grid.Column="0" Classes="well">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <c:ChromeToolButton Classes="segment nav" IconKind="back" IsEnabled="{Binding CanGoBack}"
                              AutomationProperties.Name="Back" Click="OnBack" />
          <c:ChromeToolButton Classes="segment nav" IconKind="forward" IsEnabled="{Binding CanGoForward}"
                              AutomationProperties.Name="Forward" Click="OnForward" />
          <c:ChromeToolButton Classes="segment nav" IconKind="up" IconSize="15" IsEnabled="{Binding CanGoUp}"
                              AutomationProperties.Name="Up one folder" Click="OnUp" />
        </StackPanel>
      </Border>

      <!-- Address bar: just the path. It reads as separate clickable segments, and the segment
           that is an archive carries the blue package mark — the one place the UI says you have
           crossed into a container. -->
      <Border Name="AddressBar" Grid.Column="1" Margin="8,0,0,0" Height="{x:Static ui:Theme.ToolbarControlHeight}" VerticalAlignment="Center"
              ClipToBounds="True" CornerRadius="{x:Static ui:Theme.ControlCorner}" Background="{x:Static ui:Theme.InsetBg}"
              AutomationProperties.Name="Current game or archive path">
        <DockPanel Margin="3,0,2,0">
          <c:ChromeToolButton DockPanel.Dock="Right" Width="26" Height="24" Bordered="False" IconKind="refresh" IconSize="14" IconThickness="1.5"
                              CornerRadius="{x:Static ui:Theme.InnerCorner}"
                              IsEnabled="{Binding HasWorkspace}" AutomationProperties.Name="Refresh" Click="OnRefresh" />
          <DockPanel>
            <!-- Root segment: the game, or a standalone archive. -->
            <v:NavigationSegment Name="RootSegment" DockPanel.Dock="Left" Margin="0,0,2,0" />
            <!-- The path, in the room left: leading segments fold into the overflow mark when it doesn't fit. -->
            <v:PathCrumbPanel Name="Segments" HorizontalAlignment="Left" />
          </DockPanel>
        </DockPanel>
      </Border>

      <!-- The address as text, in the address bar's place while it is edited: a click on the bar's empty part,
           Ctrl+L or Alt+D. Enter goes to what was typed or pasted; Esc, or clicking away, puts the path back. -->
      <c:FlatTextField Name="AddressField" Grid.Column="1" Margin="8,0,0,0" Height="{x:Static ui:Theme.ToolbarControlHeight}" VerticalAlignment="Center"
                       FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="{x:Static ui:Theme.FontSize}" IsVisible="False"
                       AutomationProperties.Name="Address" />

      <!-- Search mode, in the address bar's and the folder search's place: where to search, and the query with how
           it is read. Ctrl+Shift+F opens it; Esc, Back or "This folder" go back to the folder. -->

      <DockPanel Name="SearchRow" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0" IsVisible="False" VerticalAlignment="Center">
        <Panel>
          <c:FlatTextField Name="QueryField" Height="{x:Static ui:Theme.ToolbarControlHeight}" VerticalAlignment="Center"
                           FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="{x:Static ui:Theme.FontSize}"
                           LeadingIcon="search" LeadingColor="{x:Static ui:Theme.Brass}" TrailingSpace="154"
                           PlaceholderText="Search by name: text, *.ydr, or a regular expression" AutomationProperties.Name="Search the game" />
          <TextBlock Name="QueryError" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,170,0" IsHitTestVisible="False"
                     Foreground="{x:Static ui:Theme.Error}" FontFamily="{x:Static ui:Theme.UiFont}" FontSize="11" />
          <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0">
            <c:ChromeToolButton Name="CaseToggle" Width="28" Height="24" Bordered="False" Text="Aa" CornerRadius="{x:Static ui:Theme.InnerCorner}"
                                AutomationProperties.Name="Match case" Click="OnCaseToggle" />
            <c:ChromeToolButton Name="WildcardToggle" Width="28" Height="24" Bordered="False" Text="*" CornerRadius="{x:Static ui:Theme.InnerCorner}"
                                AutomationProperties.Name="Wildcards" Click="OnWildcardToggle" />
            <c:ChromeToolButton Name="RegexToggle" Width="28" Height="24" Bordered="False" Text=".*" CornerRadius="{x:Static ui:Theme.InnerCorner}"
                                AutomationProperties.Name="Regular expression" Click="OnRegexToggle" />
            <c:ChromeToolButton Name="SubfoldersToggle" Width="28" Height="24" Bordered="False" IconKind="subfolders" IconSize="14" IconThickness="1.6"
                                CornerRadius="{x:Static ui:Theme.InnerCorner}" AutomationProperties.Name="Include subfolders" Click="OnSubfoldersToggle" />
            <!-- How the text is read, then where it is looked for. -->
            <Border Width="1" Height="14" Margin="2,0" VerticalAlignment="Center" Background="{x:Static ui:Theme.Border}" />
            <Panel Name="SearchScopeSlot" VerticalAlignment="Center" />
          </StackPanel>
        </Panel>
      </DockPanel>

      <!-- The folder's search box. Where to search is the icon at its end, a button with the scopes' menu, here and in
           the search row's box: one control, moved between the two. Folder filters the folder shown; the others
           search. -->
      <Panel Name="SearchBox" Grid.Column="2" Width="232" Margin="8,0,0,0" VerticalAlignment="Center">
        <c:FlatTextField Name="SearchField" Height="{x:Static ui:Theme.ToolbarControlHeight}"
                         VerticalAlignment="Center" FontSize="{x:Static ui:Theme.FontSize}" TrailingSpace="24"
                         IsEnabled="{Binding HasWorkspace}" PlaceholderText="Search this folder" LeadingIcon="search"
                         AutomationProperties.Name="Search current entries" />
        <Panel Name="ScopeSlot" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0">
          <Border Name="ScopeWell" VerticalAlignment="Center">
            <c:ChromeToolButton Name="ScopeButton" Width="28" Height="24" Bordered="False" IconKind="folder" IconSize="14" IconThickness="1.5"
                                CornerRadius="{x:Static ui:Theme.InnerCorner}" AutomationProperties.Name="Where to search" Click="OnScopeClick" />
          </Border>
        </Panel>
      </Panel>

      <!-- List or grid: one switch, whose thumb slides under the view in use. While searching it slides away under the
           search row's box, which grows into its room, and comes back out when the search ends. -->
      <Panel Name="ViewModeSlot" Grid.Column="3" ClipToBounds="True">
        <Panel.Transitions>
          <Transitions>
            <DoubleTransition Property="Width" Duration="0:0:0.22" Easing="CubicEaseOut" />
          </Transitions>
        </Panel.Transitions>
        <c:SegmentedSwitch Name="ViewModeSwitch" HorizontalAlignment="Right" Margin="8,0,0,0" Height="{x:Static ui:Theme.ToolbarControlHeight}">
          <c:SegmentedSwitch.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
          </c:SegmentedSwitch.Transitions>
          <c:SwitchSide Icon="list" Width="30" IconSize="16" Label="List view" />
          <c:SwitchSide Icon="grid" Width="30" IconSize="15" Label="Grid view" />
        </c:SegmentedSwitch>
      </Panel>
    </Grid>
  </Panel>
</UserControl>
