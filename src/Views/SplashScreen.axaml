<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:HikariHopper.Views"
        xmlns:c="using:HikariHopper.Views.Controls"
        xmlns:ui="using:HikariHopper.Ui"
        x:Class="HikariHopper.Views.SplashScreen"
        x:DataType="v:SplashScreen"
        Width="{x:Static ui:Theme.SplashWidth}" Height="{x:Static ui:Theme.SplashHeight}"
        CanResize="False" Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="0"
        WindowDecorations="Full" WindowDecorationsTheme="{StaticResource NoDrawnDecorations}"
        WindowStartupLocation="Manual"
        Background="{x:Static ui:Theme.AppBg}"
        Title="HikariHopper">
  <!-- Port of SplashScreen.qml. This own-window identity surface is the one deliberate
       exception where green is expressive rather than state. -->
  <Panel>
    <v:SplashLivery />

    <Canvas>
      <!-- The app's lockup: the icon and the official wordmark. -->
      <Image Name="AppIcon" Canvas.Left="42" Canvas.Top="50" Width="38" Height="38"
             Source="avares://HikariHopper/Assets/Branding/icon-256.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
      <Image Name="Wordmark" Canvas.Left="90" Canvas.Top="50" Height="38"
             Source="avares://HikariHopper/Assets/Branding/wordmark-on-dark.png" RenderOptions.BitmapInterpolationMode="HighQuality"
             AutomationProperties.Name="HikariHopper" />
      <TextBlock Canvas.Left="44" Canvas.Top="100" Text="MODDING TOOLKIT" Foreground="{x:Static ui:Theme.TextDim}"
                 FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="{x:Static ui:Theme.SmallFontSize}"
                 FontWeight="Bold" LetterSpacing="1" />
    </Canvas>

    <Border Height="{x:Static ui:Theme.StatusHeight}" VerticalAlignment="Bottom" Background="{x:Static ui:Theme.ChromeBg}">
      <Panel>
        <Border Height="1" VerticalAlignment="Top" Background="{x:Static ui:Theme.Bevel}" />
        <Border Height="1" VerticalAlignment="Bottom" Background="{x:Static ui:Theme.BorderHard}" />
        <DockPanel Margin="10,0">
          <TextBlock Name="PhaseText" DockPanel.Dock="Right" Margin="18,0,0,0" Text="{Binding StartupPhase}"
                     Foreground="{x:Static ui:Theme.TextFaint}"
                     FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="{x:Static ui:Theme.SmallFontSize}"
                     VerticalAlignment="Center" />
          <TextBlock Name="MessageText" Text="{Binding StartupMessage}" Foreground="{x:Static ui:Theme.TextRow}"
                     FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="{x:Static ui:Theme.SmallFontSize}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Panel>
    </Border>

  </Panel>
</Window>
