<v:ModalSheet xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:v="using:HikariHopper.Views"
              x:Class="HikariHopper.Views.ShortcutsDialog"
              WindowShare="0.76,0.9" MinSize="440,320" MaxSize="1040,800" FitsContent="True"
              Heading="KEYBOARD SHORTCUTS">
  <!-- The keyboard reference: every key the app binds, grouped by where it works, in as many columns as the
       sheet has room for. Keys go in mono at row weight, actions in the UI face, the status bar's pairing. -->
  <ScrollViewer Name="Scroller" Theme="{StaticResource QuietScrollViewer}" HorizontalScrollBarVisibility="Disabled">
    <Border Background="Transparent" Padding="0,0,14,8">
      <v:ShortcutColumns Name="Columns" />
    </Border>
  </ScrollViewer>
</v:ModalSheet>
