<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HikariHopper.ViewModels"
             xmlns:v="using:HikariHopper.Views"
             xmlns:c="using:HikariHopper.Views.Controls"
             xmlns:ui="using:HikariHopper.Ui"
             x:Class="HikariHopper.Views.EntryTable"
             x:DataType="vm:ExplorerViewModel"
             Background="Transparent">
  <!-- Port of EntryTable.qml: the details list. Rows sit 6px inside the panel and span it; the
       NAME column takes what TYPE (200), SIZE (120) and a 14px scrollbar lane leave. -->
  <DockPanel>
    <Panel Name="HeaderRow" DockPanel.Dock="Top" Height="{x:Static ui:Theme.ListHeaderHeight}" Background="{x:Static ui:Theme.ListHeaderBg}">
      <StackPanel Orientation="Horizontal">
        <v:EntryTableHeaderCell Name="NameHeader" Text="NAME" LeftPadding="16" Clicked="OnSortName" />
        <v:EntryTableHeaderCell Name="LocationHeader" Text="LOCATION" LeftPadding="8" IsVisible="False" Clicked="OnSortLocation" />
        <v:EntryTableHeaderCell Name="TypeHeader" Text="TYPE" LeftPadding="12" Width="{x:Static v:EntryTable.TypeWidth}" Clicked="OnSortType" />
        <v:EntryTableHeaderCell Name="SizeHeader" Text="SIZE" AlignRight="True" RightPadding="12" Width="{x:Static v:EntryTable.SizeWidth}" Clicked="OnSortSize" />
      </StackPanel>
    </Panel>

    <Panel Name="ListArea" Margin="0,4" Background="Transparent">
      <ScrollViewer Name="Scroller" Theme="{StaticResource QuietOverlayScrollViewer}">
        <v:EntryRowList Name="EntryList" ItemsSource="{Binding EntriesModel}" Background="Transparent"
                        Margin="{x:Static v:EntryTable.RowMargin}"
                        Focusable="True" IsTabStop="True" FocusAdorner="{x:Null}"
                        AutomationProperties.Name="Archive entries">
          <v:EntryRowList.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </v:EntryRowList.ItemsPanel>
        </v:EntryRowList>
      </ScrollViewer>

      <v:QtCenteredPanel>
      <StackPanel Name="EmptyState" Spacing="12">
        <TextBlock Name="EmptyText" HorizontalAlignment="Center" IsHitTestVisible="False" Foreground="{x:Static ui:Theme.TextDim}"
                   FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="{x:Static ui:Theme.FontSize}" />
        <c:ChromeToolButton Name="OpenGameButton" HorizontalAlignment="Center" Width="190" Height="32" Primary="True"
                            Text="OPEN CONFIGURED GAME" Click="OnOpenConfiguredGame" />
      </StackPanel>
      </v:QtCenteredPanel>

      <Canvas Name="MarqueeLayer" IsHitTestVisible="False" ClipToBounds="False">
        <v:SelectionMarquee Name="Marquee" IsVisible="False" />
      </Canvas>
    </Panel>
  </DockPanel>
</UserControl>
