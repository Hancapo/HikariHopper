<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HikariHopper.ViewModels"
             xmlns:c="using:HikariHopper.Views.Controls"
             xmlns:ui="using:HikariHopper.Ui"
             x:Class="HikariHopper.Views.StatusBar"
             x:DataType="vm:ExplorerViewModel"
             Height="{x:Static ui:Theme.ExplorerStatusHeight}">
  <!-- Port of StatusBar.qml, on the window's base under the panels: the item count, the open
       edition behind a signal lamp, the latest status message, and the two keys that move you. -->
  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="{x:Static ui:Theme.MonoFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{x:Static ui:Theme.TextDim}" />
    </Style>
    <Style Selector="Border.divider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{x:Static ui:Theme.BorderSoft}" />
    </Style>
  </UserControl.Styles>
  <DockPanel Margin="14,0">
    <!-- Key hints, the key on a cap and what it does beside it. -->
    <StackPanel Name="Hints" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="14" Margin="14,0,0,0">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <c:KeyCap Text="Enter" />
        <TextBlock Text="Open" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <c:KeyCap IconName="delete" AutomationProperties.Name="Backspace" />
        <TextBlock Text="Up" />
      </StackPanel>
    </StackPanel>

    <!-- While the search index is being built: how far it has got, left of the key hints. -->
    <StackPanel Name="Indexing" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" IsVisible="{Binding SearchIndexing}">
      <TextBlock Text="{Binding SearchIndexText}" Foreground="{x:Static ui:Theme.TextDim}" />
      <c:ThinProgress Width="110" VerticalAlignment="Center" Value="{Binding SearchIndexProgress}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="14">
      <Panel>
        <TextBlock IsVisible="{Binding ShowsItemCount}" Text="{Binding VisibleCount, StringFormat='{}{0} items'}" />
        <TextBlock IsVisible="{Binding !HasWorkspace}" Text="NO GAME" />
      </Panel>
      <Border Name="EditionDivider" Classes="divider" />
      <!-- The signal lamp: lit while a game is open. -->
      <StackPanel Name="Edition" Orientation="Horizontal" Spacing="8">
        <Panel Width="14" Height="14" VerticalAlignment="Center">
          <Ellipse Width="14" Height="14" Fill="{x:Static ui:Theme.SelectionHalo}" />
          <Ellipse Width="8" Height="8" Fill="{x:Static ui:Theme.Selection}" />
        </Panel>
        <TextBlock Name="EditionText" Foreground="{x:Static ui:Theme.TextRow}" Text="{Binding GameEdition}" />
      </StackPanel>
      <Border Name="StatusDivider" Classes="divider" />
    </StackPanel>

    <TextBlock Name="StatusText" Margin="14,0,0,0" Foreground="{x:Static ui:Theme.TextFaint}" TextTrimming="CharacterEllipsis"
               Text="{Binding Status}" />
  </DockPanel>
</UserControl>
