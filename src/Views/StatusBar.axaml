<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HikariHopper.ViewModels"
             xmlns:c="using:HikariHopper.Views.Controls"
             xmlns:ui="using:HikariHopper.Ui"
             x:Class="HikariHopper.Views.StatusBar"
             x:DataType="vm:ExplorerViewModel"
             Height="{x:Static ui:Theme.ExplorerStatusHeight}">
  <!-- On the window's base under the panels: the game that is open, as its mark and name in a small well, the
       item count, the latest status message, and what is selected. -->
  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="{x:Static ui:Theme.MonoFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{x:Static ui:Theme.TextDim}" />
    </Style>
    <Style Selector="Border.divider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{x:Static ui:Theme.BorderSoft}" />
    </Style>
  </UserControl.Styles>
  <DockPanel Margin="8,0,14,0">
    <!-- What is selected: how many, and how big. -->
    <TextBlock Name="SelectionText" DockPanel.Dock="Right" Margin="14,0,0,0" />

    <!-- While the search index is being built: how far it has got, left of the selection. -->
    <StackPanel Name="Indexing" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" IsVisible="{Binding SearchIndexing}">
      <TextBlock Text="{Binding SearchIndexText}" Foreground="{x:Static ui:Theme.TextDim}" />
      <c:ThinProgress Width="110" VerticalAlignment="Center" Value="{Binding SearchIndexProgress}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="14">
      <!-- The game: its edition's mark, as on its tab, and its name, in a well of their own. -->
      <Border Name="Edition" Height="22" Padding="8,0" VerticalAlignment="Center"
              Background="{x:Static ui:Theme.InsetBg}" CornerRadius="{x:Static ui:Theme.ControlCorner}">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <c:EditionMark Name="EditionMark" Width="12" Height="12" VerticalAlignment="Center" />
          <TextBlock Name="EditionText" Foreground="{x:Static ui:Theme.TextRow}" Text="{Binding GameEdition}" />
        </StackPanel>
      </Border>
      <Panel Name="Count">
        <TextBlock IsVisible="{Binding ShowsItemCount}" Text="{Binding VisibleCount, StringFormat='{}{0} items'}" />
        <TextBlock IsVisible="{Binding !HasWorkspace}" Text="NO GAME" />
      </Panel>
      <Border Name="StatusDivider" Classes="divider" />
    </StackPanel>

    <TextBlock Name="StatusText" Margin="14,0,0,0" Foreground="{x:Static ui:Theme.TextFaint}" TextTrimming="CharacterEllipsis"
               Text="{Binding Status}" />
  </DockPanel>
</UserControl>
