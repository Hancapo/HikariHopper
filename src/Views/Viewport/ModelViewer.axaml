<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:HikariHopper.Views"
             xmlns:c="using:HikariHopper.Views.Controls"
             xmlns:ui="using:HikariHopper.Ui"
             x:Class="HikariHopper.Views.ModelViewer"
             v:ModalOverlay.FillsWindow="True"
             Focusable="True"
             FontFamily="{x:Static ui:Theme.UiFont}"
             FontSize="{x:Static ui:Theme.FontSize}"
             Foreground="{x:Static ui:Theme.Text}">
  <!-- A 3D file, to look at, as a modal that fills the main window, in the image viewer's frame: a header naming
       the file with a close mark; for a drawable, a toolbar of what is drawn and how; the 3D viewport; and the status
       bar: what the content holds and where, for a drawable the time of day its sun is at, and the GPU. -->
  <UserControl.Styles>
    <!-- The toolbar's wells and the buttons in them, as the texture viewer's. -->
    <Style Selector="Border.well">
      <Setter Property="Background" Value="{x:Static ui:Theme.InsetBg}" />
      <Setter Property="CornerRadius" Value="{x:Static ui:Theme.ControlCorner}" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.well > StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="2" />
    </Style>
    <Style Selector="c|ChromeToolButton.tool">
      <Setter Property="Height" Value="24" />
      <Setter Property="Width" Value="26" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Bordered" Value="False" />
      <Setter Property="InWell" Value="True" />
      <Setter Property="CornerRadius" Value="{x:Static ui:Theme.InnerCorner}" />
      <Setter Property="IconSize" Value="14" />
      <Setter Property="IconThickness" Value="1.5" />
    </Style>
    <Style Selector="c|LucideIcon.stat">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="Weight" Value="1.7" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Stroke" Value="{x:Static ui:Theme.TextFaint}" />
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="FontFamily" Value="{x:Static ui:Theme.MonoFont}" />
      <Setter Property="FontSize" Value="{x:Static ui:Theme.SmallFontSize}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{x:Static ui:Theme.TextDim}" />
    </Style>
  </UserControl.Styles>
  <Border Background="{x:Static ui:Theme.AppBg}"
          CornerRadius="{x:Static ui:Theme.SheetCorner}" BoxShadow="{x:Static ui:Theme.SheetShadow}">
    <c:RoundedClip Radius="{x:Static ui:Theme.SheetRadius}">
      <Panel>
        <DockPanel>
          <Panel DockPanel.Dock="Top" Height="{x:Static ui:Theme.WindowTitleHeight}" Background="{x:Static ui:Theme.ChromeRaised}">
            <Border Height="1" VerticalAlignment="Bottom" Background="{x:Static ui:Theme.BorderHard}" />
            <StackPanel Margin="12,0,44,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <c:FileGlyph Name="TitleGlyph" Width="13" Height="13" VerticalAlignment="Center" />
              <TextBlock Name="TitleText" VerticalAlignment="Center" FontSize="{x:Static ui:Theme.SmallFontSize}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <c:ChromeToolButton Name="CloseMark" Width="24" Height="22" Margin="0,0,6,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Bordered="False"
                                CornerRadius="{x:Static ui:Theme.InnerCorner}" IconKind="close" IconSize="11" IconThickness="1.4"
                                AutomationProperties.Name="Close the 3D viewer" />
          </Panel>

          <!-- A drawable's toolbar: the parts panel and the level of detail; whether the sun casts shadows, and the
               embedded textures; what is drawn over the model: its skeleton, bounds and lights; and, on the right, whether the camera orbits or flies, and the camera back on the model. -->
          <Panel Name="Toolbar" DockPanel.Dock="Top" Height="{x:Static ui:Theme.ModelToolbarHeight}" Background="{x:Static ui:Theme.ChromeBg}"
                 IsVisible="False">
            <Border Height="1" VerticalAlignment="Bottom" Background="{x:Static ui:Theme.BorderHard}" />
            <DockPanel Margin="6,0,6,1">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <!-- The time of day the model is lit at, which opens its slider. -->
                <Border Classes="well">
                  <Panel>
                    <c:ChromeToolButton Name="TimeButton" Classes="tool" Width="80" Padding="14,0,10,0"
                                        AutomationProperties.Name="Time of day" />
                    <c:LucideIcon IconName="clock" Width="13" Height="13" Margin="8,0,0,0" Weight="1.6"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                  Stroke="{x:Static ui:Theme.TextDim}" />
                    <c:LucideIcon IconName="chevron-down" Width="9" Height="9" Margin="0,0,8,0" Weight="1.6"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                                  Stroke="{x:Static ui:Theme.TextDim}" />
                  </Panel>
                </Border>
                <!-- The camera: orbiting the model, or flying. -->
                <Border Classes="well">
                  <StackPanel>
                    <c:ChromeToolButton Name="OrbitButton" Classes="tool" IconKind="orbit" AutomationProperties.Name="Orbit camera" />
                    <c:ChromeToolButton Name="FreeButton" Classes="tool" IconKind="free" AutomationProperties.Name="Free camera" />
                  </StackPanel>
                </Border>
                <Border Classes="well">
                  <StackPanel>
                    <c:ChromeToolButton Name="FrameButton" Classes="tool" IconKind="frame" AutomationProperties.Name="Frame the model" />
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <!-- The levels of detail the drawable has, as segments like the texture editor's channels; none when it
                     has only the one. -->
                <c:SegmentedSwitch Name="LodSwitch" IsVisible="False" />
                <Border Name="LodSeparator" Width="1" Height="20" Margin="2,0" VerticalAlignment="Center" IsVisible="False"
                        Background="{x:Static ui:Theme.BorderHard}" />
                <Border Classes="well">
                  <StackPanel>
                    <c:ChromeToolButton Name="ShadowsButton" Classes="tool" IconKind="sun" AutomationProperties.Name="Shadows" />
                  </StackPanel>
                </Border>
                <!-- The drawable's embedded textures, in the texture viewer. -->
                <Border Classes="well">
                  <StackPanel>
                    <c:ChromeToolButton Name="TexturesButton" Classes="tool" IconKind="image" AutomationProperties.Name="Embedded textures" />
                  </StackPanel>
                </Border>
                <Border Width="1" Height="20" Margin="2,0" VerticalAlignment="Center" Background="{x:Static ui:Theme.BorderHard}" />
                <!-- What is drawn over the model, through it. -->
                <Border Classes="well">
                  <StackPanel>
                    <c:ChromeToolButton Name="SkeletonButton" Classes="tool" IconKind="skeleton" AutomationProperties.Name="Skeleton" />
                    <c:ChromeToolButton Name="BoundsButton" Classes="tool" IconKind="bounds" AutomationProperties.Name="Bounds" />
                    <c:ChromeToolButton Name="LightsButton" Classes="tool" IconKind="lights" AutomationProperties.Name="Lights" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </DockPanel>
          </Panel>

          <Panel DockPanel.Dock="Bottom" Height="{x:Static ui:Theme.ExplorerStatusHeight}" Background="{x:Static ui:Theme.ChromeBg}">
            <Border Height="1" VerticalAlignment="Top" Background="{x:Static ui:Theme.Border}" />
            <Grid Margin="0,1,0,0" ColumnDefinitions="Auto,*">
              <!-- A drawable's triangles, vertices and edges. -->
              <StackPanel Name="StatsPanel" Grid.Column="0" Orientation="Horizontal" Spacing="12" Margin="10,0,0,0" IsVisible="False">
                <StackPanel Name="TrianglesStat" Orientation="Horizontal" Spacing="5" Background="Transparent">
                  <c:LucideIcon Classes="stat" IconName="triangle" />
                  <TextBlock Name="TrianglesText" Classes="status" Foreground="{x:Static ui:Theme.TextRow}" />
                </StackPanel>
                <StackPanel Name="VerticesStat" Orientation="Horizontal" Spacing="5" Background="Transparent">
                  <c:LucideIcon Classes="stat" IconName="git-commit-vertical" />
                  <TextBlock Name="VerticesText" Classes="status" Foreground="{x:Static ui:Theme.TextRow}" />
                </StackPanel>
                <StackPanel Name="EdgesStat" Orientation="Horizontal" Spacing="5" Background="Transparent">
                  <c:LucideIcon Classes="stat" IconName="slash" />
                  <TextBlock Name="EdgesText" Classes="status" Foreground="{x:Static ui:Theme.TextRow}" />
                </StackPanel>
                <!-- How fast the free camera flies, while it does. -->
                <StackPanel Name="SpeedStat" Orientation="Horizontal" Spacing="5" Background="Transparent" IsVisible="False">
                  <c:LucideIcon Classes="stat" IconName="gauge" />
                  <TextBlock Name="SpeedText" Classes="status" Foreground="{x:Static ui:Theme.TextRow}" />
                </StackPanel>
              </StackPanel>
              <TextBlock Name="StatusText" Grid.Column="1" Classes="status" Margin="10,0,0,0"
                         Foreground="{x:Static ui:Theme.TextFaint}" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Panel>

          <!-- What the colours mean: the materials of a collision, or a navmesh's ground and what is drawn on it. -->
          <Border Name="LegendBar" DockPanel.Dock="Bottom" IsVisible="False" Background="{x:Static ui:Theme.ChromeBg}" Padding="10,6,10,4">
            <WrapPanel Name="LegendPanel" ItemSpacing="14" LineSpacing="4" />
          </Border>

          <!-- The parts panel, beside the viewport: it slides open and closed, its content clipped as it does. -->
          <Border Name="PartsSide" DockPanel.Dock="Left" Width="0" ClipToBounds="True">
            <v:PartsPanel Name="Parts" HorizontalAlignment="Left" />
          </Border>
          <!-- Its edge: dragged, it resizes the panel; its arrow, in the middle, shows or hides it. -->
          <Panel Name="PartsHandle" DockPanel.Dock="Left" Width="12" IsVisible="False" Background="{x:Static ui:Theme.ChromeBg}"
                 Cursor="SizeWestEast">
            <Border Width="1" HorizontalAlignment="Right" Background="{x:Static ui:Theme.BorderHard}" />
            <c:ChromeToolButton Name="PartsArrow" Width="11" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Bordered="False" CornerRadius="{x:Static ui:Theme.InnerCorner}" IconKind="back" IconSize="10"
                                IconThickness="1.7" Cursor="Hand" AutomationProperties.Name="Parts" />
          </Panel>

          <v:ViewportHost Name="Viewport" />
        </DockPanel>

        <!-- The card's outline, drawn over the content so the content keeps the whole card. -->
        <Border BorderBrush="{x:Static ui:Theme.Border}" BorderThickness="1" CornerRadius="{x:Static ui:Theme.SheetCorner}"
                IsHitTestVisible="False" />
      </Panel>
    </c:RoundedClip>
  </Border>
</UserControl>
