<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:HikariHopper.Views"
             xmlns:c="using:HikariHopper.Views.Controls"
             xmlns:ui="using:HikariHopper.Ui"
             x:Class="HikariHopper.Views.ModelViewer"
             v:ModalOverlay.FillsWindow="True"
             Focusable="True"
             FontFamily="{x:Static ui:Theme.UiFont}"
             FontSize="{x:Static ui:Theme.FontSize}"
             Foreground="{x:Static ui:Theme.Text}">
  <!-- A 3D file, to look at, as a modal that fills the main window, in the image viewer's frame: a header naming
       the file with a close mark; the 3D viewport, with what is drawn over the model at its top; and the footer: for a
       drawable its level of detail and counts, what the content holds or lacks, the camera, and the time of day. -->
  <UserControl.Styles>
    <!-- The footer's wells and the buttons in them, as the texture viewer's toolbar's. -->
    <Style Selector="Border.well">
      <Setter Property="Background" Value="{x:Static ui:Theme.InsetBg}" />
      <Setter Property="CornerRadius" Value="{x:Static ui:Theme.ControlCorner}" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.well > StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="2" />
    </Style>
    <Style Selector="c|ChromeToolButton.tool">
      <Setter Property="Height" Value="20" />
      <Setter Property="Width" Value="26" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Bordered" Value="False" />
      <Setter Property="InWell" Value="True" />
      <Setter Property="CornerRadius" Value="{x:Static ui:Theme.InnerCorner}" />
      <Setter Property="IconSize" Value="14" />
      <Setter Property="IconThickness" Value="1.5" />
    </Style>
    <Style Selector="c|LucideIcon.stat">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="Weight" Value="1.7" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Stroke" Value="{x:Static ui:Theme.TextFaint}" />
    </Style>
    <Style Selector="TextBlock.count">
      <Setter Property="FontFamily" Value="{x:Static ui:Theme.MonoFont}" />
      <Setter Property="FontSize" Value="{x:Static ui:Theme.SmallFontSize}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{x:Static ui:Theme.TextRow}" />
    </Style>
    <Style Selector="TextBlock.unit">
      <Setter Property="FontFamily" Value="{x:Static ui:Theme.MonoFont}" />
      <Setter Property="FontSize" Value="{x:Static ui:Theme.SmallFontSize}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{x:Static ui:Theme.TextFaint}" />
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="FontFamily" Value="{x:Static ui:Theme.MonoFont}" />
      <Setter Property="FontSize" Value="{x:Static ui:Theme.SmallFontSize}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{x:Static ui:Theme.TextDim}" />
    </Style>
  </UserControl.Styles>
  <Border Background="{x:Static ui:Theme.AppBg}"
          CornerRadius="{x:Static ui:Theme.SheetCorner}" BoxShadow="{x:Static ui:Theme.SheetShadow}">
    <c:RoundedClip Radius="{x:Static ui:Theme.SheetRadius}">
      <Panel>
        <DockPanel>
          <Panel DockPanel.Dock="Top" Height="{x:Static ui:Theme.WindowTitleHeight}" Background="{x:Static ui:Theme.ChromeRaised}">
            <Border Height="1" VerticalAlignment="Bottom" Background="{x:Static ui:Theme.BorderHard}" />
            <StackPanel Margin="12,0,44,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <c:FileGlyph Name="TitleGlyph" Width="13" Height="13" VerticalAlignment="Center" />
              <TextBlock Name="TitleText" VerticalAlignment="Center" FontSize="{x:Static ui:Theme.SmallFontSize}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <c:ChromeToolButton Name="CloseMark" Width="24" Height="22" Margin="0,0,6,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Bordered="False"
                                CornerRadius="{x:Static ui:Theme.InnerCorner}" IconKind="close" IconSize="11" IconThickness="1.4"
                                AutomationProperties.Name="Close the 3D viewer" />
          </Panel>

          <!-- The footer. On the left, for a drawable: its level of detail, which opens a list of them upward, and the
               counts of what is drawn, behind a button. Then the status line. On the right: how fast the camera flies,
               while it does; whether it orbits or flies; and, for a drawable, the time of day it is lit at. -->
          <Panel Name="Footer" DockPanel.Dock="Bottom" Height="{x:Static ui:Theme.ModelFooterHeight}" Background="{x:Static ui:Theme.ChromeBg}">
            <Border Height="1" VerticalAlignment="Top" Background="{x:Static ui:Theme.BorderHard}" />
            <DockPanel Margin="8,1,8,0">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <StackPanel Name="SpeedStat" Orientation="Horizontal" Spacing="5" Background="Transparent" IsVisible="False">
                  <c:LucideIcon Classes="stat" IconName="gauge" />
                  <TextBlock Name="SpeedText" Classes="status" />
                </StackPanel>
                <c:SegmentedSwitch Name="CameraSwitch" Height="{x:Static ui:Theme.ModelFooterControlHeight}" VerticalAlignment="Center" />
                <!-- The time of day the model is lit at, on a small dial of the day, which opens the dial above it. -->
                <Border Name="TimeWell" Classes="well" IsVisible="False">
                  <Panel>
                    <c:ChromeToolButton Name="TimeButton" Classes="tool" Width="80" Padding="14,0,10,0"
                                        AutomationProperties.Name="Time of day" />
                    <v:TimeDial Name="TimeGlyph" Compact="True" Width="13" Height="13" Margin="8,0,0,0" Focusable="False"
                                HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <c:LucideIcon IconName="chevron-up" Width="9" Height="9" Margin="0,0,8,0" Weight="1.6"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                                  Stroke="{x:Static ui:Theme.TextDim}" />
                  </Panel>
                </Border>
              </StackPanel>
              <StackPanel Name="ModelTools" DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" IsVisible="False">
                <!-- The level shown, with its triangles; a list of the four above it, or the one level as plain text. -->
                <Border Name="LodWell" Height="{x:Static ui:Theme.ModelFooterControlHeight}" MinWidth="96" Padding="9,0,8,0"
                        VerticalAlignment="Center" Background="{x:Static ui:Theme.InsetBg}"
                        CornerRadius="{x:Static ui:Theme.ControlCorner}" Focusable="True"
                        AutomationProperties.Name="Level of detail">
                  <DockPanel>
                    <c:LucideIcon Name="LodCaret" DockPanel.Dock="Right" IconName="chevron-up" Width="9" Height="9" Margin="10,0,0,0"
                                  Weight="1.6" VerticalAlignment="Center" Stroke="{x:Static ui:Theme.TextDim}" />
                    <TextBlock Name="LodCount" DockPanel.Dock="Right" Classes="unit" Margin="8,0,0,0" />
                    <TextBlock Name="LodText" Classes="count" Foreground="{x:Static ui:Theme.Text}" FontSize="{x:Static ui:Theme.FontSize}" />
                  </DockPanel>
                </Border>
                <Border Width="1" Height="14" VerticalAlignment="Center" Background="{x:Static ui:Theme.Border}" />
                <Border Classes="well">
                  <StackPanel>
                    <c:ChromeToolButton Name="StatsButton" Classes="tool" IconKind="stats" AutomationProperties.Name="Mesh counts" />
                  </StackPanel>
                </Border>
                <!-- What is drawn: its triangles, vertices and edges, while the counts are on. -->
                <StackPanel Name="StatsPanel" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <StackPanel Name="TrianglesStat" Orientation="Horizontal" Spacing="4" Background="Transparent">
                    <TextBlock Name="TrianglesText" Classes="count" />
                    <TextBlock Classes="unit" Text="tris" />
                  </StackPanel>
                  <StackPanel Name="VerticesStat" Orientation="Horizontal" Spacing="4" Background="Transparent">
                    <TextBlock Name="VerticesText" Classes="count" />
                    <TextBlock Classes="unit" Text="verts" />
                  </StackPanel>
                  <StackPanel Name="EdgesStat" Orientation="Horizontal" Spacing="4" Background="Transparent">
                    <TextBlock Name="EdgesText" Classes="count" />
                    <TextBlock Classes="unit" Text="edges" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
              <TextBlock Name="StatusText" Classes="status" Margin="12,0,8,0"
                         Foreground="{x:Static ui:Theme.TextFaint}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </Panel>

          <!-- The parts panel, beside the viewport: it slides open and closed, its content clipped as it does. For a
               collision or a navmesh it lists what the colours mean: the materials, or the ground and what is drawn on it. -->
          <Border Name="PartsSide" DockPanel.Dock="Left" Width="0" ClipToBounds="True">
            <v:PartsPanel Name="Parts" HorizontalAlignment="Left" />
          </Border>
          <!-- Its edge, while it's open: dragged, it resizes the panel. -->
          <Panel Name="PartsHandle" DockPanel.Dock="Left" Width="{x:Static ui:Theme.PartsEdgeWidth}" IsVisible="False"
                 Background="{x:Static ui:Theme.AppBg}" Cursor="SizeWestEast">
            <Border Width="1" HorizontalAlignment="Right" Background="{x:Static ui:Theme.BorderHard}" />
          </Panel>

          <v:ViewportHost Name="Viewport" />
        </DockPanel>

        <!-- Drawn over the viewport, each in a window of its own (ViewportOverlay), as Blender draws its tools over its
             view: at the left edge's top, the parts panel's arrow, a tab that shows or hides it; and centred at the top,
             a drawable's overlay row: whether the sun casts shadows, and whether its skeleton, collision and lights are
             drawn over it. Taken from here when the viewer is made. -->
        <Panel Name="ToolsHolder" IsVisible="False">
          <Border Name="PartsTab" Padding="1,2,2,2" TextElement.Foreground="{x:Static ui:Theme.Text}"
                  Background="{x:Static ui:Theme.ChromeBg}" BorderBrush="{x:Static ui:Theme.BorderHard}"
                  BorderThickness="0,1,1,1" CornerRadius="0,5,5,0">
            <c:ChromeToolButton Name="PartsArrow" Width="12" Height="40" Bordered="False"
                                CornerRadius="{x:Static ui:Theme.InnerCorner}" IconKind="back" IconSize="10"
                                IconThickness="1.7" Cursor="Hand" AutomationProperties.Name="Parts" />
          </Border>
          <!-- The overlay toggles, joined into one rounded row with no panel behind them, as Blender's viewport
               buttons are: each a solid segment, the accent when on, its glyph faded when the model has nothing to
               show (its tooltip says so). -->
          <Border Name="ToolStrip" TextElement.Foreground="{x:Static ui:Theme.Text}">
            <Border.Styles>
              <Style Selector="c|ChromeToolButton.tool">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Bordered" Value="False" />
                <Setter Property="Segment" Value="True" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="IconSize" Value="14" />
                <Setter Property="IconThickness" Value="1.5" />
                <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
              </Style>
            </Border.Styles>
            <c:RoundedClip Radius="{x:Static ui:Theme.ControlRadius}">
              <StackPanel Orientation="Horizontal" Spacing="1" Background="{x:Static ui:Theme.BorderHard}">
                <c:ChromeToolButton Name="ShadowsButton" Classes="tool" IconKind="shadows" AutomationProperties.Name="Shadows" />
                <c:ChromeToolButton Name="SkeletonButton" Classes="tool" IconKind="skeleton" AutomationProperties.Name="Skeleton" />
                <c:ChromeToolButton Name="SolidButton" Classes="tool" IconKind="collision" AutomationProperties.Name="Collision" />
                <c:ChromeToolButton Name="LightsButton" Classes="tool" IconKind="lights" AutomationProperties.Name="Lights" />
              </StackPanel>
            </c:RoundedClip>
          </Border>
        </Panel>

        <!-- The card's outline, drawn over the content so the content keeps the whole card. -->
        <Border BorderBrush="{x:Static ui:Theme.Border}" BorderThickness="1" CornerRadius="{x:Static ui:Theme.SheetCorner}"
                IsHitTestVisible="False" />
      </Panel>
    </c:RoundedClip>
  </Border>
</UserControl>
