<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:HikariHopper.Views.Controls"
                    xmlns:ui="using:HikariHopper.Ui">
  <!-- Port of WindowControlButton.qml: a 34px divided cell with an application-drawn 1px mark.
       Hover and keyboard focus brighten only the mark. -->
  <ControlTheme x:Key="{x:Type c:WindowControlButton}" TargetType="c:WindowControlButton">
    <Setter Property="Padding" Value="0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border Name="PART_Separator" Width="1" HorizontalAlignment="Left"
                  Background="{x:Static ui:Theme.BorderHard}" IsVisible="{TemplateBinding Separated}" />
          <c:WindowControlGlyph Name="PART_Glyph" Kind="{TemplateBinding Kind}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
