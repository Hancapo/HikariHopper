<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:HikariHopper.Views.Controls"
                    xmlns:ui="using:HikariHopper.Ui">
  <!-- Port of QuietScrollBar.qml. The bar paints itself (QuietScrollBar.Render); the template
       only gives it a transparent surface so the whole 12px gutter is its hit area, as in Qt. -->
  <ControlTheme x:Key="{x:Type c:QuietScrollBar}" TargetType="c:QuietScrollBar">
    <Setter Property="Width" Value="{x:Static ui:Theme.ScrollbarWidth}" />
    <Style Selector="^:horizontal">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Height" Value="{x:Static ui:Theme.ScrollbarWidth}" />
    </Style>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- The QML lists anchor their ListView with rightMargin: scrollbarWidth and parent the bar in
       the reserved 12px gutter on the right. Apply with Theme="{StaticResource QuietScrollViewer}". -->
  <ControlTheme x:Key="QuietScrollViewer" TargetType="ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto">
          <ScrollContentPresenter Name="PART_ContentPresenter" Grid.Column="0"
                                  Content="{TemplateBinding Content}"
                                  Padding="{TemplateBinding Padding}" />
          <c:QuietScrollBar Name="PART_VerticalScrollBar" Grid.Column="1" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ScrollBar.vertical attached without re-parenting (e.g. the texture rail): the bar sits over
       the right edge of the content instead of beside it. -->
  <ControlTheme x:Key="QuietOverlayScrollViewer" TargetType="ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ScrollContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  Padding="{TemplateBinding Padding}" />
          <c:QuietScrollBar Name="PART_VerticalScrollBar" HorizontalAlignment="Right" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Both ways, for content that is wide as well as long (the text viewer): the bars float over the
       right and bottom edges of the content, the bottom one stopping short of the right one. -->
  <ControlTheme x:Key="QuietBothScrollViewer" TargetType="ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ScrollContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  Padding="{TemplateBinding Padding}" />
          <c:QuietScrollBar Name="PART_VerticalScrollBar" HorizontalAlignment="Right" />
          <c:QuietScrollBar Name="PART_HorizontalScrollBar" Orientation="Horizontal" VerticalAlignment="Bottom"
                            Margin="0,0,12,0" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
