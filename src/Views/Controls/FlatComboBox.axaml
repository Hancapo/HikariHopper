<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:HikariHopper.Views.Controls"
                    xmlns:ui="using:HikariHopper.Ui">
  <!-- Port of FlatComboBox.qml. The popup sits directly under the well, as wide as it, at most
       280px tall with 4px padding, framed like RetroMenu (a hard border on rounded corners). -->
  <ControlTheme x:Key="{x:Type c:FlatComboBox}" TargetType="c:FlatComboBox">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="FontFamily" Value="{x:Static ui:Theme.MonoFont}" />
    <Setter Property="FontSize" Value="{x:Static ui:Theme.FontSize}" />
    <Setter Property="MaxDropDownHeight" Value="280" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Background" BorderThickness="1" CornerRadius="{x:Static ui:Theme.ControlCorner}" />
          <DockPanel>
            <c:ChromeIcon Name="PART_Caret" DockPanel.Dock="Right" Kind="caretDown" Thickness="1.6" Width="14" Height="14" Margin="0,0,8,0"
                          VerticalAlignment="Center" />
            <!-- The selected option's note, if it has one: what it costs, say. -->
            <TextBlock Name="PART_DisplayNote" DockPanel.Dock="Right" Margin="8,0,10,0" Text="{TemplateBinding CurrentNote}"
                       Foreground="{x:Static ui:Theme.TextFaint}"
                       FontFamily="{TemplateBinding FontFamily}" FontSize="{x:Static ui:Theme.SmallFontSize}"
                       VerticalAlignment="Center" />
            <TextBlock Name="PART_Display" Margin="10,0,0,0"
                       FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <Popup Name="PART_Popup"
                 IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                 Placement="BottomEdgeAlignedLeft"
                 IsLightDismissEnabled="True"
                 InheritsTransform="True">
            <Border Name="PART_PopupFrame" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                    Background="{x:Static ui:Theme.ChromeRaised}" CornerRadius="{x:Static ui:Theme.TabCorner}"
                    BorderBrush="{x:Static ui:Theme.BorderHard}" BorderThickness="1">
              <Border Padding="3">
                <ScrollViewer Theme="{StaticResource BareScrollViewer}" VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:FlatComboBoxItem}" TargetType="c:FlatComboBoxItem">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Background" CornerRadius="{x:Static ui:Theme.InnerCorner}">
          <DockPanel Margin="{TemplateBinding Padding}">
            <TextBlock Name="PART_Note" DockPanel.Dock="Right" Margin="8,0,0,0" Text="{TemplateBinding Note}"
                       Foreground="{x:Static ui:Theme.TextDim}"
                       FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="{x:Static ui:Theme.SmallFontSize}"
                       VerticalAlignment="Center" />
            <TextBlock Name="PART_Label" Text="{TemplateBinding Label}"
                       FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="{x:Static ui:Theme.FontSize}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
