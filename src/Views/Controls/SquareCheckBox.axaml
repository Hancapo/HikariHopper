<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:HikariHopper.Views.Controls"
                    xmlns:ui="using:HikariHopper.Ui">
  <!-- Port of SquareCheckBox.qml: a 16px sunken square (4px corners) with an 8px accent fill when
       checked, on the Qt Basic CheckBox geometry (6px padding, 8px spacing). -->
  <ControlTheme x:Key="{x:Type c:SquareCheckBox}" TargetType="c:SquareCheckBox">
    <Setter Property="Padding" Value="6" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="FontFamily" Value="{x:Static ui:Theme.UiFont}" />
    <Setter Property="FontSize" Value="{x:Static ui:Theme.FontSize}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Panel Margin="{TemplateBinding Padding}">
            <Border Name="PART_Indicator" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="{x:Static ui:Theme.InsetBg}" BorderThickness="1" CornerRadius="{x:Static ui:Theme.KeyCapCorner}">
              <Panel>
                <Border Name="PART_Check" Margin="3" CornerRadius="2" Background="{x:Static ui:Theme.Accent}" />
                <!-- Partly: some of what it stands for is on. -->
                <Border Name="PART_Partial" Height="2" Margin="3,0" CornerRadius="1" VerticalAlignment="Center"
                        Background="{x:Static ui:Theme.Accent}" IsVisible="False" />
              </Panel>
            </Border>
            <TextBlock Name="PART_Text" Text="{TemplateBinding Text}" Margin="24,0,0,0"
                       FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                       VerticalAlignment="Center" />
          </Panel>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
