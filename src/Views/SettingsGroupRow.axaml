<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:HikariHopper.Views"
             xmlns:ui="using:HikariHopper.Ui"
             x:Class="HikariHopper.Views.SettingsGroupRow"
             x:DataType="v:SettingsGroupRow">
  <!-- One group of the Settings rail: its name, and a note such as "soon" for groups still to come.
       The selected group wears the explorer's selection: a soft wash with a ring. -->
  <Border Name="Surface" Margin="6,1" Padding="10,0" CornerRadius="{x:Static ui:Theme.ItemCorner}" BorderThickness="1">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock Name="LabelText" VerticalAlignment="Center"
                 FontFamily="{x:Static ui:Theme.UiFont}" FontSize="{x:Static ui:Theme.FontSize}"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock Name="NoteText" Grid.Column="1" VerticalAlignment="Center" Foreground="{x:Static ui:Theme.TextFaint}"
                 FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="9" />
    </Grid>
  </Border>
</UserControl>
