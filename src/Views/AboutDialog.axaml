<v:ModalSheet xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:v="using:HikariHopper.Views"
              xmlns:c="using:HikariHopper.Views.Controls"
              xmlns:ui="using:HikariHopper.Ui"
              x:Class="HikariHopper.Views.AboutDialog"
              x:DataType="v:AboutDialog"
              WindowShare="0.4,0.55" MinSize="440,380" MaxSize="540,460"
              Heading="ABOUT"
              FooterText="FiveFury · Avalonia · Archivo, Space Mono, Inter">
  <!-- The app's own lockup, centred: the icon over the wordmark, what it is, the version in a
       sunken chip, and links to the project and its changes. The credits sit in the footer line. -->
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
    <Image Name="AppIcon" Width="56" Height="56" HorizontalAlignment="Center"
           Source="avares://HikariHopper/Assets/Branding/icon-256.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
    <Image Name="Wordmark" Height="26" Margin="0,14,0,0" HorizontalAlignment="Center" Stretch="Uniform"
           Source="avares://HikariHopper/Assets/Branding/wordmark-on-dark.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Text="A modding toolkit for games"
               Foreground="{x:Static ui:Theme.TextDim}" FontFamily="{x:Static ui:Theme.UiFont}" FontSize="{x:Static ui:Theme.FontSize}" />
    <Border Margin="0,14,0,0" HorizontalAlignment="Center" Padding="10,4"
            Background="{x:Static ui:Theme.InsetBg}" CornerRadius="{x:Static ui:Theme.ControlCorner}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Version " Foreground="{x:Static ui:Theme.TextRow}"
                   FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="{x:Static ui:Theme.SmallFontSize}" />
        <TextBlock Name="VersionText" Text="{x:Static v:StartPage.AppVersion}" Foreground="{x:Static ui:Theme.TextRow}"
                   FontFamily="{x:Static ui:Theme.MonoFont}" FontSize="{x:Static ui:Theme.SmallFontSize}" />
      </StackPanel>
    </Border>
    <StackPanel Margin="0,22,0,0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
      <c:ChromeToolButton Name="GitHubButton" Width="104" Height="28" Raised="True" Text="GitHub"
                          AutomationProperties.Name="Open HikariHopper on GitHub" />
      <c:ChromeToolButton Name="ChangelogButton" Width="104" Height="28" Raised="True" Text="Changelog"
                          AutomationProperties.Name="Open the changelog" />
    </StackPanel>
  </StackPanel>
</v:ModalSheet>
