  "vehicle_specular": {
    "about": "What each PS_DeferredVehicleTextured shader writes to the G-buffer's specular intensity, power and fresnel, as decoded from its program, for an undamaged, dry vehicle. intensity = vertex AO * scale * map * rough; power = power_scale * power; fresnel as given. scale: 'mult' (specularIntensityMult) or a number. map: 'masked' (specMapIntMask . (R², G², B)), 'red' (R²) or null. rough: 'dirt' (one less the dirt map's roughness), 'level' (dirtLevelMod.z) or null. power: 'alpha' (A), 'green' (G²) or null; power_scale: 'falloff' (specularFalloffMult) or a number. fresnel: 'constant' (specularFresnel), 'blue' (one less B) or a number. uv: the UV set the specular map is read on; tiled: by specTexTileUV. bump: a fixed bumpiness.",
    "default": { "scale": "mult", "map": "masked", "rough": "dirt", "power": "alpha", "power_scale": "falloff", "fresnel": "constant", "uv": 0, "tiled": false },
