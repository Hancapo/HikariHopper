<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>HikariHopper</RootNamespace>
    <AssemblyName>HikariHopper</AssemblyName>
    <Version>0.3.0</Version>
    <ApplicationIcon>Assets\Branding\HikariHopper.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The COM and P/Invoke source generators (ShellFileDrag) emit unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Releases are Native AOT (tools/release.ps1). This also runs the AOT and trimming analyzers on every build,
         and code they flag fails it rather than the published app. -->
    <PublishAot>true</PublishAot>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2057;IL2060;IL2062;IL2065;IL2067;IL2070;IL2072;IL2075;IL2077;IL2080;IL2087;IL2090;IL2091;IL2111;IL3000;IL3002;IL3050;IL3051</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" Exclude="Assets/Keys/**;Assets/Fonts/Source/**;Assets/Branding/*.svg;Assets/Branding/hikarihopper-*.png" />
    <!-- The repo's changelog, for About's changelog sheet: the same file, so the app always shows its own. -->
    <AvaloniaResource Include="../CHANGELOG.md" Link="Assets/CHANGELOG.md" />
    <!-- Source of the static Archivo instances; regenerate them with tools/make_archivo_instances.py. -->
    <None Include="Assets/Fonts/Source/**" />
    <EmbeddedResource Include="Assets/Keys/keys.bin" LogicalName="HikariHopper.keys.bin" />
    <!-- RDR2's RPF8 tables (RedFury's RF8C format), for game build 1.0.1491.50. -->
    <EmbeddedResource Include="Assets/Keys/rpf8.dat" LogicalName="HikariHopper.rpf8.dat" />
    <!-- Shaders, read by their folder and name: the shared ones by concern ("Scene/scene.wgsl"), each game's by game ("Gta5/sky.wgsl"). -->
    <EmbeddedResource Include="Rendering/Shaders/modules.txt" LogicalName="HikariHopper.Shaders.modules.txt" />
    <EmbeddedResource Include="Rendering/Shaders/Scene/*" LogicalName="HikariHopper.Shaders.Scene/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Rendering/Shaders/Post/*" LogicalName="HikariHopper.Shaders.Post/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Rendering/Shaders/World/*" LogicalName="HikariHopper.Shaders.World/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Games/Gta5/Shaders/*" LogicalName="HikariHopper.Shaders.Gta5/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Games/Rdr2/Shaders/*" LogicalName="HikariHopper.Shaders.Rdr2/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Arrays up to 4 MB (the most the GC takes) are allocated young rather than in the large object heap: the worlds'
         streaming threads read and build hundreds of megabytes of those a second, which kept the large object heap's
         background collections running and held the UI thread's own allocations, and so its frames, up behind them. -->
    <RuntimeHostConfigurationOption Include="System.GC.LOHThreshold" Value="4194304" />
  </ItemGroup>
  <ItemGroup>
    <!-- The native linker records only the PDB's file name (MSVC's %_PDB%), not this machine's path to it. -->
    <LinkerArg Include="/PDBALTPATH:%25_PDB%25" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <!-- FiveFury (GTA V), RedFury (RDR2) and the CommonFury they share. -->
  <Import Project="../GameLibraries.props" />
  <!-- The GPU layer's implementation for the backend built (Directory.Build.props). -->
  <ItemGroup>
    <Compile Remove="Rendering/Gpu/D3D12/**" Condition="'$(GpuBackend)' != 'D3D12'" />
    <Compile Remove="Rendering/Gpu/Wgpu/**" Condition="'$(GpuBackend)' != 'Wgpu'" />
  </ItemGroup>
  <!-- Direct3D 12 draws with shaders compiled as the app is built: every module of Shaders/modules.txt, through
       tools/ShaderCompiler (Naga to HLSL, DXC to DXIL; it needs Rust's cargo), embedded as one pack. -->
  <PropertyGroup Condition="'$(GpuBackend)' == 'D3D12'">
    <ShaderCompilerRoot>$(MSBuildProjectDirectory)/../tools/ShaderCompiler/</ShaderCompilerRoot>
    <ShaderCompiler>$(ShaderCompilerRoot)target/release/shader-compiler.exe</ShaderCompiler>
  </PropertyGroup>
  <Target Name="BuildShaderCompiler" Condition="'$(GpuBackend)' == 'D3D12'"
          Inputs="$(ShaderCompilerRoot)Cargo.toml;$(ShaderCompilerRoot)Cargo.lock;@(ShaderCompilerSource)" Outputs="$(ShaderCompiler)">
    <Exec Command="cargo build --release --quiet --manifest-path &quot;$(ShaderCompilerRoot)Cargo.toml&quot;" />
    <Touch Files="$(ShaderCompiler)" />
  </Target>
  <ItemGroup Condition="'$(GpuBackend)' == 'D3D12'">
    <ShaderCompilerSource Include="$(ShaderCompilerRoot)src/**/*.rs" />
  </ItemGroup>
  <Target Name="ShaderPackPath" Condition="'$(GpuBackend)' == 'D3D12'">
    <PropertyGroup>
      <ShaderPack>$(ProjectDir)$(IntermediateOutputPath)shaders.dxil.pack</ShaderPack>
    </PropertyGroup>
  </Target>
  <Target Name="CompileShaders" BeforeTargets="BeforeBuild" DependsOnTargets="BuildShaderCompiler;ShaderPackPath" Condition="'$(GpuBackend)' == 'D3D12'"
          Inputs="@(ShaderSource);$(ShaderCompiler)" Outputs="$(ShaderPack)">
    <ItemGroup>
      <ShaderFile Include="@(EmbeddedResource)" Condition="$([System.String]::Copy('%(EmbeddedResource.LogicalName)').StartsWith('HikariHopper.Shaders.'))" />
      <ShaderLine Include="@(ShaderFile->'$([System.String]::Copy('%(ShaderFile.LogicalName)').Substring(21))=%(ShaderFile.FullPath)')" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)shader-files.txt" Lines="@(ShaderLine)" Overwrite="true" />
    <Exec Command="&quot;$(ShaderCompiler)&quot; &quot;$(MSBuildProjectDirectory)/Rendering/Shaders/modules.txt&quot; &quot;$(IntermediateOutputPath)shader-files.txt&quot; &quot;$(PkgMicrosoft_Direct3D_DXC)/build/native/bin/x64/dxc.exe&quot; &quot;$(IntermediateOutputPath)shader-cache&quot; &quot;$(ShaderPack)&quot;" />
    <ItemGroup>
      <EmbeddedResource Include="$(ShaderPack)" LogicalName="HikariHopper.Shaders.dxil.pack" Visible="false" />
    </ItemGroup>
  </Target>
  <ItemGroup Condition="'$(GpuBackend)' == 'D3D12'">
    <ShaderSource Include="Rendering/Shaders/**/*;Games/*/Shaders/**/*" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HikariHopper.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- tools/release.ps1 sets HikariHopperRelease=true; every other build (debug runs, local publishes) is a dev build. -->
    <AssemblyMetadata Include="HikariHopperRelease" Value="$(HikariHopperRelease)" />
  </ItemGroup>
</Project>
